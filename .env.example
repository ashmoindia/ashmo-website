# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ManyChat webhook intake
MANYCHAT_WEBHOOK_SECRET=
MANYCHAT_API_KEY=

# Admin protection
ADMIN_USERNAME=ashmo
ADMIN_PASSWORD=

# Optional downstream automations
# n8n receives our events and writes to Notion. Set these once n8n is live.
N8N_SUBMISSION_WEBHOOK_URL=
N8N_ADMIN_EVENT_WEBHOOK_URL=

# Notion is normally addressed through n8n; these direct-Notion vars are
# only used if a Netlify Function ever writes to Notion directly.
NOTION_API_KEY=
NOTION_CHALLENGES_DATABASE_ID=
NOTION_PARTICIPANTS_DATABASE_ID=
NOTION_ENTRIES_DATABASE_ID=
NOTION_WINNERS_DATABASE_ID=

# Marketing and analytics
# Use PUBLIC_META_PIXEL_ID so Astro exposes it to the client-side pixel snippet.
# META_PIXEL_ID (no prefix) is still read as a fallback.
PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=

# Existing site integrations
RESEND_API_KEY=
SOCIAL_POSTING_SECRET=
