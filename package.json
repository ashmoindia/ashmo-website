{
  "name": "ashmo-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/seo-check.mjs",
    "build:no-seo": "astro build",
    "lint": "astro check",
    "test:pm": "node --test tests/paper-moon-core.test.mjs tests/paper-moon-surface.test.mjs",
    "test:tip": "node --test tests/tip-surface.test.mjs",
    "seo": "node scripts/seo-check.mjs",
    "build:premium-workbooks": "python3 tools/build-premium-workbooks.py",
    "qa:premium-workbooks": "python3 tools/build-premium-workbooks.py --qa-only",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/inter-tight": "^5.2.7",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.0.6",
    "bcryptjs": "^3.0.3",
    "resend": "^6.9.4",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "yaml-language-server": {
      "yaml": "^2.9.0"
    }
  },
  "description": "```sh npm create astro@latest -- --template minimal ```",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
