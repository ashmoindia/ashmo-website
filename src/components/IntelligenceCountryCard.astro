---
import type { IntelligenceCountry } from '../data/intelligence';

interface Props {
  country: IntelligenceCountry;
}

const { country } = Astro.props;
---

<article class="group overflow-hidden rounded-[1.65rem] border border-white/6 bg-[linear-gradient(145deg,rgba(18,21,24,0.98),rgba(14,16,19,0.98))]">
  <div class="relative overflow-hidden px-6 py-6 md:px-7 md:py-7">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(212,135,90,0.14),transparent_42%)]"></div>
    <div class="absolute inset-y-0 right-0 w-40 bg-[linear-gradient(135deg,transparent,rgba(233,193,118,0.08))]"></div>
    <div class="relative">
      <p class="text-[0.66rem] uppercase tracking-[0.24em] text-accent-light">{country.eyebrow}</p>
      <h2 class="mt-4 text-[2rem] md:text-[2.4rem] font-semibold tracking-[-0.05em] font-body text-text">
        {country.shortName}
      </h2>
      <p class="mt-4 max-w-[36rem] text-sm md:text-[0.98rem] text-text-secondary leading-[1.8]">
        {country.summary}
      </p>
      <div class="mt-6 flex flex-wrap gap-2">
        <span class="rounded-full border border-white/8 px-3 py-1 text-[0.64rem] uppercase tracking-[0.16em] text-text-tertiary">
          Legal-safe dashboard
        </span>
        <span class="rounded-full border border-white/8 px-3 py-1 text-[0.64rem] uppercase tracking-[0.16em] text-text-tertiary">
          Linked public sources
        </span>
      </div>
      <a
        href={`/intelligence/countries/${country.slug}/`}
        class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-accent-light no-underline transition-transform group-hover:translate-x-1"
      >
        Explore country page
        <span>&rarr;</span>
      </a>
    </div>
  </div>
</article>
