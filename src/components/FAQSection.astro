---
/**
 * FAQSection
 * Renders a visible FAQ block AND emits FAQPage JSON-LD. Pass an array of
 * { q, a } items. Each answer can be plain text or simple HTML.
 *
 * Usage:
 *   <FAQSection
 *     title="Frequently asked"
 *     items={[{ q: 'Question?', a: 'Answer.' }]}
 *   />
 */
interface Item { q: string; a: string }
interface Props {
  items: Item[];
  title?: string;
  /** Heading element for the section title. Default h2. */
  as?: 'h2' | 'h3';
}

const { items, title = 'Frequently asked', as = 'h2' } = Astro.props;
const HeadingTag = as;

const faqSchema = items.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      'mainEntity': items.map((item) => ({
        '@type': 'Question',
        'name': item.q,
        'acceptedAnswer': {
          '@type': 'Answer',
          // Schema needs HTML/text — strip our markdown-ish chars conservatively.
          'text': item.a,
        },
      })),
    }
  : null;
---

{faqSchema && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}

{items.length > 0 && (
  <section class="section-shell pb-18 md:pb-24" aria-labelledby="faq-heading">
    <p class="mono-label mb-4">FAQ</p>
    <HeadingTag id="faq-heading" class="section-title max-w-[18ch] mb-10">{title}</HeadingTag>

    <div class="grid gap-3">
      {items.map((item) => (
        <details class="group rounded-[1.25rem] border border-white/8 bg-white/[0.04] p-5 md:p-6 transition-colors hover:border-white/15 open:border-white/20 open:bg-white/[0.06]">
          <summary class="flex cursor-pointer items-start justify-between gap-4 list-none">
            <span class="font-heading text-[1.05rem] md:text-[1.15rem] font-semibold leading-snug text-text">{item.q}</span>
            <span class="mt-1 inline-flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border border-white/15 text-accent-light transition-transform group-open:rotate-45" aria-hidden="true">
              +
            </span>
          </summary>
          <div class="mt-4 text-[0.95rem] leading-[1.7] text-text-secondary" set:html={item.a}></div>
        </details>
      ))}
    </div>
  </section>
)}
