---
interface Item {
  href: string;
  label: string;
}

interface Props {
  items: Item[];
  rootHref: string;
}

const { items, rootHref } = Astro.props;
const currentPath = Astro.url.pathname;
const isActive = (href: string) => (
  href === rootHref
    ? currentPath === href
    : currentPath === href || currentPath.startsWith(href)
);
---

<div class="section-shell pb-10 md:pb-12">
  <div class="card-base rounded-[1.25rem] p-2">
    <nav class="relative z-10 flex gap-2 overflow-x-auto" aria-label="Section navigation">
      {items.map((item) => (
        <a
          href={item.href}
          class:list={[
            'shrink-0 rounded-full border px-4 py-2.5 font-mono text-[0.68rem] font-semibold uppercase tracking-[0.08em] no-underline transition-colors duration-200',
            isActive(item.href)
              ? 'border-accent/50 bg-accent/14 text-accent-light'
              : 'border-white/8 bg-white/[0.03] text-text-tertiary hover:border-border-light hover:text-text',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</div>
