---
interface Item {
  href: string;
  label: string;
}

interface Props {
  items: Item[];
  rootHref: string;
}

const { items, rootHref } = Astro.props;
const currentPath = Astro.url.pathname;
const isActive = (href: string) => (
  href === rootHref
    ? currentPath === href
    : currentPath === href || currentPath.startsWith(href)
);
---

<div class="border-y border-border bg-surface/60 backdrop-blur-sm">
  <div class="max-w-[1200px] mx-auto px-6 md:px-12">
    <nav class="flex gap-3 md:gap-4 overflow-x-auto py-4" aria-label="Section navigation">
      {items.map((item) => (
        <a
          href={item.href}
          class:list={[
            'shrink-0 rounded-full border px-4 py-2 text-[0.72rem] font-medium uppercase tracking-[0.16em] no-underline transition-colors duration-200',
            isActive(item.href)
              ? 'border-accent/50 bg-accent/12 text-accent-light'
              : 'border-border text-text-tertiary hover:border-border-light hover:text-text',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</div>
