---
interface Props {
  number: string;
  title: string;
  description: string;
  purple?: boolean;
}

const { number, title, description, purple = false } = Astro.props;
---

<a
  href="/thinking/"
  class:list={[
    "feature-card hover-lift block p-8 no-underline md:p-9",
    purple
      ? "hover:border-secondary"
      : "hover:border-accent",
  ]}
>
  <div class="relative z-10">
    <p
      class="mono-label mb-5"
      style={`color: ${purple ? 'var(--color-secondary-light)' : 'var(--color-accent-light)'}`}
    >
      {number}
    </p>
    <h3 class="text-lg font-bold leading-[1.12] text-text md:text-xl">{title}</h3>
    <p class="mt-3 text-sm leading-relaxed text-text-secondary">{description}</p>
  </div>
</a>
