---
const navLinks = [
  { href: "/thinking/", label: "Thinking" },
  { href: "/intelligence/", label: "Intelligence" },
  { href: "/challenges/", label: "Challenges" },
  { href: "/restaurant-cafe-growth-systems/", label: "Growth" },
  { href: "/principles/", label: "Principles" },
  { href: "/work/", label: "Work" },
  { href: "/podcast/", label: "Podcast" },
  { href: "/story/", label: "Story" },
];

const currentPath = Astro.url.pathname;
const isGrowthPath = currentPath.startsWith('/restaurant-cafe-growth-systems/') || currentPath.startsWith('/restaurant-finance/');
const isContactPath = currentPath.startsWith('/contact/');
---

<header class="sticky top-0 z-40 px-4 pt-3 md:px-6 md:pt-4 xl:px-8">
  <div class="mx-auto max-w-[1560px]">
    <nav class="rounded-[26px] border border-border bg-[rgba(7,7,17,0.78)] px-4 py-3 shadow-[0_18px_70px_rgba(0,0,0,0.34)] backdrop-blur-xl md:px-5 md:py-3.5">
      <div class="flex items-center justify-between gap-4 lg:grid lg:grid-cols-[auto_1fr_auto] lg:items-center lg:gap-5">
      <a href="/" class="flex items-center rounded-full border border-transparent px-2 py-1 no-underline transition-opacity hover:opacity-90" aria-label="ashmo.io home">
        <span class="font-heading text-[1.45rem] font-extrabold leading-none tracking-[-0.02em] text-text md:text-[1.6rem]">
          ashmo<span class="text-accent-light">.io</span>
        </span>
      </a>

      <ul class="hidden lg:flex items-center justify-center gap-1 list-none">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={[
                "inline-flex items-center rounded-full px-3.5 py-2 font-mono text-[0.68rem] font-semibold uppercase tracking-[0.06em] transition-all duration-200 no-underline",
                (link.href === "/restaurant-cafe-growth-systems/" ? isGrowthPath : currentPath.startsWith(link.href))
                  ? "bg-white/10 text-text shadow-[inset_0_0_0_1px_rgba(255,255,255,0.08)]"
                  : "text-text-tertiary hover:bg-white/6 hover:text-text"
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="flex items-center justify-end gap-2 md:gap-3">
        <a
          href="/contact/"
          class:list={[
            "inline-flex min-h-11 items-center justify-center rounded-full px-4 py-2 font-mono text-[0.68rem] font-semibold uppercase tracking-[0.06em] no-underline transition-all duration-200 md:px-5 md:py-2.5 md:text-[0.7rem]",
            isContactPath
              ? "border border-accent/40 bg-white/6 text-text hover:border-accent/60 hover:bg-white/10"
              : "bg-gradient-to-r from-accent-light via-accent to-secondary text-bg shadow-[0_14px_40px_rgba(212,135,90,0.24)] hover:-translate-y-0.5 hover:shadow-[0_18px_46px_rgba(201,162,212,0.22)]"
          ]}
          style={!isContactPath ? "color: var(--color-bg);" : undefined}
        >
          Contact
        </a>

        <button
          id="mobile-menu-btn"
          class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-white/[0.04] text-text-tertiary transition-colors hover:text-text lg:hidden"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <line x1="4" y1="7" x2="20" y2="7" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="17" x2="20" y2="17" />
          </svg>
        </button>
      </div>
    </div>

      <div id="mobile-menu" class="hidden lg:hidden mt-4 border-t border-white/8 pt-4">
        <ul class="flex flex-col gap-2 list-none">
          {navLinks.map(link => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "flex min-h-11 items-center rounded-[18px] px-4 py-3 font-mono text-[0.82rem] font-semibold uppercase tracking-[0.06em] transition-all duration-200 no-underline",
                  (link.href === "/restaurant-cafe-growth-systems/" ? isGrowthPath : currentPath.startsWith(link.href))
                    ? "bg-white/7 text-text"
                    : "text-text-secondary hover:bg-white/4 hover:text-text"
                ]}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    const isExpanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!isExpanded));
  });
</script>
