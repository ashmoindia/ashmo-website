---
/**
 * HeroExchange
 * The 1:1 right-side asset for the homepage hero.
 * "What you bring → What you get" — plain-language transformation card.
 */
---

<div class="exchange gradient-border" aria-label="What you bring becomes what you get, with Ashmo as the operator">
  <div class="exchange-inner">

    <div class="ex-head">
      <span class="ex-head-l">The Exchange</span>
      <span class="ex-head-r">
        <span class="ex-pulse" aria-hidden="true"></span>
        Live · Working
      </span>
    </div>

    <div class="ex-cols">
      <span class="ex-col ex-col-l">What you bring</span>
      <span class="ex-col-mid" aria-hidden="true">&rarr;</span>
      <span class="ex-col ex-col-r">What you get</span>
    </div>

    <div class="ex-row">
      <div class="ex-side">
        <span class="ex-lbl"><span class="ex-dot in-1"></span>Brand</span>
        <span class="ex-sub">how you look</span>
      </div>
      <span class="ex-arrow" aria-hidden="true"></span>
      <div class="ex-side ex-side-r">
        <span class="ex-lbl"><span class="ex-dot out-1"></span>Sales</span>
        <span class="ex-sub">more customers</span>
      </div>
    </div>

    <div class="ex-row">
      <div class="ex-side">
        <span class="ex-lbl"><span class="ex-dot in-2"></span>Marketing</span>
        <span class="ex-sub">how you sell</span>
      </div>
      <span class="ex-arrow" aria-hidden="true"></span>
      <div class="ex-side ex-side-r">
        <span class="ex-lbl"><span class="ex-dot out-2"></span>Revenue</span>
        <span class="ex-sub">growing monthly</span>
      </div>
    </div>

    <div class="ex-row">
      <div class="ex-side">
        <span class="ex-lbl"><span class="ex-dot in-3"></span>Ops</span>
        <span class="ex-sub">how it runs</span>
      </div>
      <span class="ex-arrow" aria-hidden="true"></span>
      <div class="ex-side ex-side-r">
        <span class="ex-lbl"><span class="ex-dot out-3"></span>Trust</span>
        <span class="ex-sub">people choose you</span>
      </div>
    </div>

    <div class="ex-foot">
      <span>You bring the business · <b>I bring the customers</b></span>
      <span class="ex-by">— Ashmo</span>
    </div>
  </div>

  <div class="ex-operator" aria-hidden="true">
    <span class="ex-pulse"></span>
    via Ashmo
  </div>
</div>

<style>
  .exchange {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    max-width: 32rem;
    margin-inline: auto;
    border-radius: var(--radius-card-lg);
    overflow: hidden;
    background:
      radial-gradient(circle at 12% 0%, rgba(212, 135, 90, 0.18), transparent 42%),
      radial-gradient(circle at 96% 12%, rgba(201, 162, 212, 0.16), transparent 40%),
      linear-gradient(180deg, var(--color-surface) 0%, var(--color-bg-deep) 100%);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-glow-secondary);
  }
  .exchange-inner {
    position: absolute; inset: 0;
    padding: 1.65rem 1.65rem;
    display: flex; flex-direction: column;
    z-index: 1;
  }

  .ex-head {
    display: flex; align-items: center; justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.62rem; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--color-text-tertiary);
    font-weight: 600;
  }
  .ex-head-l { color: var(--color-primary-light); }
  .ex-head-r {
    display: inline-flex; align-items: center; gap: 0.5rem;
    color: var(--color-text-tertiary);
  }
  .ex-pulse {
    width: 0.4rem; height: 0.4rem; border-radius: 50%;
    background: var(--color-primary);
    box-shadow: 0 0 0.6rem rgba(212, 135, 90, 0.7);
    animation: ex-pulse 2.2s ease-in-out infinite;
  }
  @keyframes ex-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

  .ex-cols {
    margin-top: 1.15rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
    padding-bottom: 0.85rem;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.08);
  }
  .ex-col {
    font-family: var(--font-mono);
    font-size: 0.62rem; letter-spacing: 0.28em; text-transform: uppercase;
    font-weight: 600;
  }
  .ex-col-l { color: var(--color-secondary-light); }
  .ex-col-r { color: var(--color-primary-light); text-align: right; }
  .ex-col-mid {
    font-family: var(--font-mono);
    font-size: 0.6rem; letter-spacing: 0.22em;
    color: var(--color-text-tertiary);
  }

  .ex-row {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding-block: 0.85rem;
  }
  .ex-row:last-of-type { border-bottom: none; }

  .ex-side { display: flex; flex-direction: column; gap: 0.25rem; }
  .ex-side-r { align-items: flex-end; text-align: right; }
  .ex-lbl {
    display: inline-flex; align-items: center; gap: 0.6rem;
    font-family: var(--font-heading);
    font-size: 1.2rem; font-weight: 720; letter-spacing: -0.01em;
    color: var(--color-text);
    line-height: 1;
  }
  .ex-side-r .ex-lbl { flex-direction: row-reverse; }
  .ex-dot {
    width: 0.55rem; height: 0.55rem; border-radius: 50%;
    flex-shrink: 0;
  }
  .ex-dot.in-1  { background: var(--color-secondary-light); box-shadow: 0 0 0.75rem rgba(226, 194, 235, 0.6); }
  .ex-dot.in-2  { background: var(--color-secondary);       box-shadow: 0 0 0.75rem rgba(201, 162, 212, 0.6); }
  .ex-dot.in-3  { background: #a785b8;                       box-shadow: 0 0 0.75rem rgba(167, 133, 184, 0.55); }
  .ex-dot.out-1 { background: var(--color-primary-light);   box-shadow: 0 0 0.75rem rgba(241, 178, 132, 0.6); }
  .ex-dot.out-2 { background: var(--color-primary);          box-shadow: 0 0 0.75rem rgba(212, 135, 90, 0.6); }
  .ex-dot.out-3 { background: #b56d44;                       box-shadow: 0 0 0.75rem rgba(181, 109, 68, 0.55); }

  .ex-sub {
    font-size: 0.78rem;
    color: var(--color-text-tertiary);
    letter-spacing: 0.02em;
  }

  .ex-arrow {
    width: 4.6rem;
    height: 1px;
    background: linear-gradient(90deg, rgba(201, 162, 212, 0.18), rgba(212, 135, 90, 0.75));
    position: relative;
  }
  .ex-arrow::after {
    content: ""; position: absolute; right: -1px; top: -3px;
    width: 0; height: 0;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    border-left: 6px solid var(--color-primary);
  }

  .ex-operator {
    position: absolute; left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    background: rgba(7, 7, 17, 0.88);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(212, 135, 90, 0.42);
    border-radius: 999px;
    padding: 0.42rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.62rem; font-weight: 700;
    letter-spacing: 0.28em; text-transform: uppercase;
    color: var(--color-primary-light);
    display: inline-flex; align-items: center; gap: 0.5rem;
    box-shadow: 0 0 2.5rem rgba(212, 135, 90, 0.22), 0 0 1.5rem rgba(201, 162, 212, 0.16);
    z-index: 2;
    pointer-events: none;
    white-space: nowrap;
  }

  .ex-foot {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px dashed rgba(255, 255, 255, 0.08);
    display: flex; align-items: center; justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.78rem;
    color: var(--color-text-tertiary);
  }
  .ex-foot b {
    font-weight: 700;
    background: linear-gradient(90deg, var(--color-primary-light), var(--color-secondary-light));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ex-by {
    font-family: var(--font-mono);
    font-size: 0.6rem; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--color-text-tertiary);
    font-weight: 600;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .exchange-inner { padding: 1.2rem 1.1rem; }
    .ex-lbl { font-size: 1rem; }
    .ex-sub { font-size: 0.7rem; }
    .ex-arrow { width: 2rem; }
    .ex-operator { font-size: 0.55rem; padding: 0.32rem 0.7rem; }
    .ex-foot { font-size: 0.7rem; flex-direction: column; align-items: flex-start; gap: 0.4rem; }
  }
</style>
