---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  href?: string;
  metadata?: string;
  accent?: 'warm' | 'soft';
}

const {
  eyebrow,
  title,
  description,
  href,
  metadata,
  accent = 'warm',
} = Astro.props;

const accentClass = accent === 'soft'
  ? 'group-hover:border-secondary/30'
  : 'group-hover:border-accent/30';
---
{href ? (
  <a
    href={href}
    class:list={[
      'feature-card hover-lift group block p-6 no-underline',
      accentClass,
    ]}
  >
    <div class="relative z-10">
      {eyebrow && <p class="mono-label mb-3">{eyebrow}</p>}
      <p class="text-[1.35rem] font-bold leading-[1.12] text-text md:text-[1.45rem]">{title}</p>
      <p class="mt-4 text-[0.96rem] leading-[1.75] text-text-secondary">{description}</p>
      <div class="mt-6 flex items-center justify-between gap-4 font-mono text-[0.72rem] font-semibold uppercase tracking-[0.08em] text-text-tertiary">
        <span>{metadata}</span>
        <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
      </div>
    </div>
  </a>
) : (
  <div class="feature-card p-6">
    <div class="relative z-10">
      {eyebrow && <p class="mono-label mb-3">{eyebrow}</p>}
      <p class="text-[1.35rem] font-bold leading-[1.12] text-text md:text-[1.45rem]">{title}</p>
      <p class="mt-4 text-[0.96rem] leading-[1.75] text-text-secondary">{description}</p>
      {metadata && <p class="mt-6 font-mono text-[0.72rem] font-semibold uppercase tracking-[0.08em] text-text-tertiary">{metadata}</p>}
    </div>
  </div>
)}
