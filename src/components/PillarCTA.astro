---
interface Action {
  href: string;
  label: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  primary: Action;
  secondary?: Action;
}

const { eyebrow, title, description, primary, secondary } = Astro.props;
---

<section class="max-w-[1200px] mx-auto px-6 md:px-12 pb-20 md:pb-28">
  <div class="rounded-[1.8rem] border border-border bg-[linear-gradient(140deg,rgba(24,24,23,0.96),rgba(12,12,12,0.98))] px-7 py-10 md:px-10 md:py-12 flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8">
    <div class="max-w-[46rem]">
      <p class="text-[0.72rem] uppercase tracking-[0.18em] text-accent mb-3">{eyebrow}</p>
      <h2 class="font-heading text-3xl md:text-[2.6rem] tracking-[-0.03em] leading-[1.04] mb-4">
        {title}
      </h2>
      <p class="text-[1rem] text-text-secondary font-light leading-[1.85]">
        {description}
      </p>
    </div>
    <div class="flex flex-col sm:flex-row gap-4">
      <a href={primary.href} class="inline-flex items-center justify-center rounded-full bg-accent px-6 py-3 text-sm font-medium text-bg no-underline hover:bg-accent-light transition-colors" style="color: var(--color-bg);">
        {primary.label}
      </a>
      {secondary && (
        <a href={secondary.href} class="inline-flex items-center justify-center rounded-full border border-border-light px-6 py-3 text-sm font-medium text-text no-underline hover:border-accent/40 hover:text-accent-light transition-colors">
          {secondary.label}
        </a>
      )}
    </div>
  </div>
</section>
