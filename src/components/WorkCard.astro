---
interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  slug: string;
  tags?: string[];
  featured?: boolean;
}

const { title, description, date, category, slug, tags = [], featured = false } = Astro.props;

const categoryLabels: Record<string, string> = {
  'brand-building': 'Brand Systems',
  'founder-documentary': 'Platform Build',
  'merchant-mindset': 'Commercial Foundation',
};

const purpleCategories = ['founder-documentary'];
const isPurple = purpleCategories.includes(category);
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: featured ? 'long' : 'short',
  day: featured ? 'numeric' : undefined,
});
const accentTint = isPurple ? 'rgba(201,162,212,0.14)' : 'rgba(212,135,90,0.14)';
---

<a
  href={`/work/${slug}/`}
  class:list={[
    "group case-card hover-lift block no-underline",
    featured ? "col-span-full p-6 md:p-8 lg:p-10" : "h-full p-5 md:p-6",
  ]}
>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[rgba(30,22,16,0.18)] to-transparent"
  />
  <div
    class="pointer-events-none absolute -right-24 -top-24 h-56 w-56 rounded-full blur-3xl"
    style={`background: radial-gradient(circle, ${accentTint} 0%, transparent 72%)`}
  />
  <div
    class="pointer-events-none absolute -bottom-24 -left-10 h-52 w-52 rounded-full blur-3xl"
    style={`background: radial-gradient(circle, ${isPurple ? 'rgba(201,162,212,0.08)' : 'rgba(212,135,90,0.08)'} 0%, transparent 74%)`}
  />

  <div class:list={['relative z-10', featured ? 'grid gap-7 lg:grid-cols-[minmax(0,0.3fr)_minmax(0,0.7fr)] lg:gap-10' : 'flex h-full flex-col']}>
    <div class:list={[featured ? 'flex flex-col justify-between gap-5 rounded-[1.35rem] border border-white/6 bg-white/[0.03] px-5 py-5' : 'flex items-start justify-between gap-4']}>
      <div>
        <p
          class="font-mono text-[0.66rem] font-semibold uppercase tracking-[0.08em]"
          style={`color: ${isPurple ? 'var(--color-secondary-light)' : 'var(--color-accent-light)'}`}
        >
          {categoryLabels[category] || category}
        </p>
        <p class="mt-3 font-mono text-[0.72rem] uppercase tracking-[0.06em] text-text-tertiary">
          {formattedDate}
        </p>
      </div>

      <div class:list={[featured ? 'space-y-3' : 'text-right']}>
        <p class="font-mono text-[0.66rem] uppercase tracking-[0.06em] text-text-tertiary">Lens</p>
        <p class="text-[0.82rem] font-medium text-text-secondary">{featured ? 'Case file' : 'Project note'}</p>
      </div>
    </div>

    <div class:list={[featured ? 'flex min-h-full flex-col justify-between' : 'mt-6 flex flex-1 flex-col']}>
      <div>
        <h3
          class:list={[
            'font-heading font-bold leading-[1.04] tracking-normal transition-colors duration-200',
            featured ? 'text-[2rem] md:text-[2.7rem] max-w-[13ch]' : 'text-[1.45rem] md:text-[1.65rem]',
            isPurple ? 'group-hover:text-secondary-light' : 'group-hover:text-accent-light',
          ]}
        >
          {title}
        </h3>

        <p class:list={[
          'text-text-secondary font-light leading-[1.78]',
          featured ? 'mt-5 max-w-[40rem] text-[1rem] md:text-[1.05rem]' : 'mt-4 text-[0.94rem]',
        ]}>
          {description}
        </p>
      </div>

      <div class:list={[featured ? 'mt-8 flex flex-col gap-5 md:flex-row md:items-end md:justify-between' : 'mt-6 flex flex-wrap items-center justify-between gap-4 pt-5 border-t border-white/6']}>
        <div class="flex flex-wrap gap-2">
          {tags.slice(0, featured ? 3 : 2).map((tag) => (
            <span class="inline-flex rounded-full border border-white/8 bg-white/[0.03] px-3 py-1 font-mono text-[0.66rem] uppercase tracking-[0.06em] text-text-secondary">
              {tag}
            </span>
          ))}
        </div>

        <span
          class:list={[
            'inline-flex items-center gap-2 font-mono text-[0.72rem] font-semibold uppercase tracking-[0.06em] transition-colors duration-200',
            isPurple ? 'text-secondary/80 group-hover:text-secondary-light' : 'text-accent/80 group-hover:text-accent-light',
          ]}
        >
          Open case file <span aria-hidden="true">&rarr;</span>
        </span>
      </div>
    </div>
  </div>
</a>
