---
const year = new Date().getFullYear();
const exploreLinks = [
  { href: '/thinking/', label: 'Insights' },
  { href: '/intelligence/', label: 'Market Intelligence' },
  { href: '/challenges/', label: 'AI Workflows' },
  { href: '/growth/', label: 'Growth Systems' },
  { href: '/concepts/', label: 'F&B Concepts' },
  { href: '/work/', label: 'Case Studies' },
];

const companyLinks = [
  { href: '/principles/', label: 'Building Principles' },
  { href: '/podcast/', label: 'Conversations' },
  { href: '/story/', label: 'About' },
  { href: '/ashraf-hassan/', label: 'About Ashmo' },
];

const utilityLinks = [
  { href: '/privacy-policy/', label: 'Privacy' },
  { href: '/terms/', label: 'Terms' },
  { href: '/data-policy/', label: 'Data' },
  { href: '/cookies/', label: 'Cookies' },
  { href: '/copyright/', label: 'Copyright' },
  { href: '/disclaimer/', label: 'Disclaimer' },
  { href: '/compliance/', label: 'Compliance' },
  { href: '/legal/', label: 'All legal' },
];

const socialLinks = [
  {
    href: 'https://www.linkedin.com/in/iamashmo/',
    label: 'LinkedIn',
    icon: 'linkedin',
    external: true,
  },
  {
    href: 'https://www.instagram.com/iam_ashmo/',
    label: 'Instagram',
    icon: 'instagram',
    external: true,
  },
  {
    href: 'https://www.facebook.com/iamashmo/',
    label: 'Facebook',
    icon: 'facebook',
    external: true,
  },
  {
    href: 'https://www.youtube.com/@iamashmo',
    label: 'YouTube',
    icon: 'youtube',
    external: true,
  },
];
---

<footer class="mx-auto max-w-[1560px] px-4 pb-6 md:px-6 md:pb-10 xl:px-8">
  <div class="cta-panel overflow-hidden rounded-[2rem] shadow-[0_24px_90px_rgba(0,0,0,0.24)]">
    <div class="relative px-6 py-8 md:px-8 md:py-10">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(212,135,90,0.16),transparent_30%),radial-gradient(circle_at_bottom_right,rgba(201,162,212,0.12),transparent_28%)]"></div>

      <div class="relative grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)_minmax(280px,0.7fr)] lg:gap-12">
        <div class="max-w-[34rem]">
          <p class="mono-label">Ashmo</p>
          <a href="/ashraf-hassan/" class="mt-4 inline-flex items-center gap-4 no-underline">
            <span class="flex h-14 w-14 items-center justify-center rounded-[1.15rem] border border-white/8 bg-white/[0.03]">
              <img src="/images/logo-emblem-white.svg" alt="Ashmo" class="h-8 w-auto opacity-95" />
            </span>
            <span class="block">
              <span class="block text-[1.65rem] font-bold tracking-normal text-text">Ashraf Hassan</span>
              <span class="mt-1 block font-mono text-[0.85rem] uppercase tracking-[0.06em] text-accent-light">Ashmo</span>
            </span>
          </a>
          <p class="mt-5 text-[1rem] leading-[1.8] text-text-secondary">
            Commercial strategy, F&amp;B growth, AI-age marketing systems, and practical business judgment.
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-3">
            {socialLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="me noopener"
                aria-label={link.label}
                class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/8 bg-white/[0.03] text-text-secondary transition-all duration-200 no-underline hover:-translate-y-0.5 hover:border-accent/40 hover:bg-accent/10 hover:text-accent-light"
              >
                {link.icon === 'linkedin' && (
                  <svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4 fill-current">
                    <path d="M6.94 8.5H3.56V20h3.38zm.22-3.69a1.96 1.96 0 1 0-3.92 0 1.96 1.96 0 0 0 3.92 0M20 12.73c0-3.36-1.79-4.92-4.18-4.92-1.93 0-2.8 1.06-3.28 1.81V8.5H9.16c.04.74 0 11.5 0 11.5h3.38v-6.42c0-.34.03-.68.13-.92.27-.67.88-1.36 1.91-1.36 1.35 0 1.89 1.02 1.89 2.52V20H20z" />
                  </svg>
                )}
                {link.icon === 'instagram' && (
                  <svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4 fill-none stroke-current" stroke-width="1.85">
                    <rect x="3.25" y="3.25" width="17.5" height="17.5" rx="5" />
                    <circle cx="12" cy="12" r="4.15" />
                    <circle cx="17.55" cy="6.45" r="1.1" fill="currentColor" stroke="none" />
                  </svg>
                )}
                {link.icon === 'facebook' && (
                  <svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4 fill-current">
                    <path d="M13.47 20.5v-7.06h2.37l.35-2.76h-2.72V8.92c0-.8.22-1.35 1.36-1.35h1.45V5.1c-.25-.03-1.12-.1-2.13-.1-2.11 0-3.56 1.29-3.56 3.66v2.02H8.25v2.76h2.34v7.06z" />
                  </svg>
                )}
                {link.icon === 'youtube' && (
                  <svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4 fill-none stroke-current" stroke-width="1.85" stroke-linejoin="round">
                    <path d="M21 12.2c0 2.3-.27 4.09-.49 4.84a2.58 2.58 0 0 1-1.82 1.82c-.75.22-2.54.49-6.69.49s-5.94-.27-6.69-.49a2.58 2.58 0 0 1-1.82-1.82C3.27 16.29 3 14.5 3 12.2s.27-4.09.49-4.84A2.58 2.58 0 0 1 5.31 5.54c.75-.22 2.54-.49 6.69-.49s5.94.27 6.69.49a2.58 2.58 0 0 1 1.82 1.82c.22.75.49 2.54.49 4.84Z" />
                    <path d="m10.25 8.95 5.1 3.05-5.1 3.05z" fill="currentColor" stroke="none" />
                  </svg>
                )}
              </a>
            ))}
          </div>
        </div>

        <div class="grid gap-8 sm:grid-cols-2">
          <div>
            <p class="font-mono text-[0.65rem] uppercase tracking-[0.06em] text-text-tertiary">Explore</p>
            <nav aria-label="Footer explore" class="mt-4 flex flex-col gap-3">
              {exploreLinks.map((link) => (
                <a
                  href={link.href}
                  class="text-sm text-text-secondary transition-colors no-underline hover:text-text"
                >
                  {link.label}
                </a>
              ))}
            </nav>
          </div>

          <div>
            <p class="font-mono text-[0.65rem] uppercase tracking-[0.06em] text-text-tertiary">More</p>
            <nav aria-label="Footer company" class="mt-4 flex flex-col gap-3">
              {companyLinks.map((link) => (
                <a
                  href={link.href}
                  class="text-sm text-text-secondary transition-colors no-underline hover:text-text"
                >
                  {link.label}
                </a>
              ))}
            </nav>
          </div>
        </div>

        <div class="rounded-[1.5rem] border border-white/8 bg-white/[0.04] p-5 md:p-6">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.06em] text-accent-light">Start here</p>
          <h2 class="mt-4 text-[1.5rem] font-bold tracking-normal text-text">
            Need clarity on brand, growth, or market direction?
          </h2>
          <p class="mt-4 text-sm leading-[1.75] text-text-secondary">
            Use the contact page if you want to talk through a brand, growth, market, or AI-age marketing decision.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href="/contact/"
              class="button-gradient px-5 py-3"
              style="color: var(--color-bg);"
            >
              Contact Ashmo
            </a>
            <a
              href="/intelligence/"
              class="button-secondary px-5 py-3 text-text-secondary"
            >
              Browse Market Intelligence
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="border-t border-white/6 px-6 py-4 md:px-8 md:py-5">
      <p class="mb-3 text-[0.7rem] leading-[1.7] text-text-tertiary md:text-xs">
        This platform provides independent educational content only. It does not disclose confidential information of any employer, client, partner, or third party. <a href="/employment-disclaimer/" class="underline decoration-text-tertiary/40 underline-offset-4 hover:text-text-secondary">Read the full position.</a>
      </p>
      <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <p class="text-xs text-text-tertiary">&copy; {year} Ashmo. Commercial intelligence, built with restraint and clarity.</p>

        <div class="flex flex-wrap gap-x-5 gap-y-2">
          {utilityLinks.map((link) => (
            <a
              href={link.href}
              class="text-xs text-text-tertiary hover:text-text-secondary transition-colors no-underline"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>
