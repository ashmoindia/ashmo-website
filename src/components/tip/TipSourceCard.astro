---
interface Source {
  type: string;
  title: string;
  url: string;
  publisher: string;
  accessedAt: string;
  confidence: string;
  note: string;
}

interface Props {
  source: Source;
}

const { source } = Astro.props;
const sourceType = source.type.replaceAll('_', ' ');
---

<article class="rounded-[1.35rem] border border-white/8 bg-white/[0.04] p-5">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <p class="font-mono text-[0.62rem] font-semibold uppercase tracking-[0.08em] text-accent-light">{sourceType}</p>
    <span class="rounded-full border border-white/10 px-2.5 py-1 font-mono text-[0.58rem] uppercase tracking-[0.08em] text-text-tertiary">
      {source.confidence}
    </span>
  </div>
  <h3 class="mt-4 text-[1.08rem] font-semibold leading-[1.25] text-text">{source.title}</h3>
  <p class="mt-3 text-sm leading-[1.75] text-text-secondary">{source.note}</p>
  <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-white/8 pt-4">
    <p class="text-[0.72rem] text-text-tertiary">{source.publisher} · accessed {source.accessedAt}</p>
    <a href={source.url} target="_blank" rel="noopener noreferrer" class="font-mono text-[0.68rem] uppercase tracking-[0.06em] text-accent-light no-underline hover:text-text">
      Open source &rarr;
    </a>
  </div>
</article>

