---
import { tipDisclaimer } from '../../data/tip.mjs';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<aside class:list={[
  'rounded-[1.5rem] border border-accent/20 bg-accent/[0.07]',
  compact ? 'p-5' : 'p-6 md:p-7',
]} aria-label="TIP disclaimer">
  <p class="font-mono text-[0.65rem] font-semibold uppercase tracking-[0.1em] text-accent-light">Independent educational tool</p>
  <p class:list={['mt-3 leading-[1.8] text-text-secondary', compact ? 'text-[0.82rem]' : 'text-sm']}>
    {tipDisclaimer}
  </p>
</aside>

