---
import ConfidenceBadge from './ConfidenceBadge.astro';

interface Props {
  product: {
    slug: string;
    name: string;
    brand: string;
    categoryLabel: string;
    manufacturer: { name: string };
    status: string;
    lastReviewedAt: string;
    summary: string;
  };
}

const { product } = Astro.props;
---

<article class="tip-product-card rounded-[1.5rem] border border-white/8 bg-white/[0.045] p-5 md:p-6" data-product-card>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="font-mono text-[0.64rem] uppercase tracking-[0.08em] text-accent-light">{product.categoryLabel}</p>
      <h2 class="mt-3 text-[1.55rem] font-semibold tracking-[-0.035em] text-text">{product.name}</h2>
      <p class="mt-2 text-sm text-text-tertiary">{product.brand} · {product.manufacturer.name}</p>
    </div>
    <ConfidenceBadge status={product.status} />
  </div>
  <p class="mt-5 line-clamp-3 text-sm leading-[1.75] text-text-secondary">{product.summary}</p>
  <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-white/8 pt-4">
    <p class="text-[0.72rem] text-text-tertiary">Last reviewed {product.lastReviewedAt}</p>
    <a href={`/tip/products/${product.slug}/`} class="font-mono text-[0.68rem] uppercase tracking-[0.06em] text-accent-light no-underline hover:text-text">
      View OG Trace Report &rarr;
    </a>
  </div>
</article>

