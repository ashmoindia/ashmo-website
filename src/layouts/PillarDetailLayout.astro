---
import BaseLayout from './BaseLayout.astro';
import PillarSectionNav from '../components/PillarSectionNav.astro';
import PillarBreadcrumbs from '../components/PillarBreadcrumbs.astro';
import PillarResourceCard from '../components/PillarResourceCard.astro';
import PillarCTA from '../components/PillarCTA.astro';

interface LinkItem {
  href: string;
  label: string;
}

interface RelatedItem {
  href: string;
  title: string;
  description: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  navItems: LinkItem[];
  breadcrumbs: LinkItem[];
  related?: RelatedItem[];
  ctaTitle?: string;
  ctaDescription?: string;
  primaryCta: LinkItem;
  secondaryCta?: LinkItem;
}

const {
  title,
  description,
  eyebrow,
  navItems,
  breadcrumbs,
  related = [],
  ctaTitle = 'If the growth problem is bigger than one campaign, fix the system behind it.',
  ctaDescription = 'Use this page as a diagnostic lens, then move into a growth audit or strategy call to identify the highest-leverage next move.',
  primaryCta,
  secondaryCta,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <PillarSectionNav items={navItems} rootHref="/restaurant-cafe-growth-systems/" />

  <article class="max-w-[1200px] mx-auto px-6 md:px-12 pt-10 md:pt-16">
    <PillarBreadcrumbs items={breadcrumbs} />

    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,0.72fr)_minmax(19rem,0.28fr)] gap-12 lg:gap-16">
      <div class="max-w-[760px]">
        <p class="mb-4 text-[0.72rem] uppercase tracking-[0.2em] text-accent">{eyebrow}</p>
        <h1 class="font-heading text-4xl md:text-[3.6rem] leading-[0.98] tracking-[-0.04em] mb-5">
          {title}
        </h1>
        <p class="max-w-[680px] text-[1.08rem] md:text-[1.14rem] text-text-secondary font-light leading-[1.85] mb-10">
          {description}
        </p>
        <div class="w-14 h-px bg-accent mb-12"></div>
        <div class="space-y-12">
          <slot />
        </div>
      </div>

      <aside class="lg:pt-16">
        <div class="sticky top-8 rounded-[1.25rem] border border-border bg-surface/70 px-6 py-6">
          <p class="mb-4 text-[0.72rem] uppercase tracking-[0.16em] text-accent-light">Best next moves</p>
          <div class="space-y-3">
            <a href={primaryCta.href} class="block text-sm text-text hover:text-accent transition-colors no-underline">
              {primaryCta.label} &rarr;
            </a>
            {secondaryCta && (
              <a href={secondaryCta.href} class="block text-sm text-text hover:text-accent transition-colors no-underline">
                {secondaryCta.label} &rarr;
              </a>
            )}
            <a href="/restaurant-cafe-growth-systems/templates/" class="block text-sm text-text hover:text-accent transition-colors no-underline">
              Open templates & trackers &rarr;
            </a>
            <a href="/restaurant-finance/" class="block text-sm text-text hover:text-accent transition-colors no-underline">
              Explore restaurant finance &rarr;
            </a>
          </div>
        </div>
      </aside>
    </div>
  </article>

  {related.length > 0 && (
    <section class="max-w-[1200px] mx-auto px-6 md:px-12 py-16 md:py-20">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10">
        <div>
          <p class="text-[0.72rem] uppercase tracking-[0.18em] text-accent mb-3">Related pages</p>
          <h2 class="font-heading text-3xl md:text-[2.6rem] tracking-[-0.03em] leading-[1.04]">
            Adjacent parts of the growth system.
          </h2>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {related.map((item) => (
          <PillarResourceCard
            eyebrow="Related"
            title={item.title}
            description={item.description}
            href={item.href}
            metadata="Open page"
          />
        ))}
      </div>
    </section>
  )}

  <PillarCTA
    eyebrow="Next step"
    title={ctaTitle}
    description={ctaDescription}
    primary={primaryCta}
    secondary={secondaryCta}
  />
</BaseLayout>
