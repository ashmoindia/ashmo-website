---
import BaseLayout from './BaseLayout.astro';
import PillarSectionNav from '../components/PillarSectionNav.astro';
import PillarBreadcrumbs from '../components/PillarBreadcrumbs.astro';
import PillarResourceCard from '../components/PillarResourceCard.astro';
import PillarCTA from '../components/PillarCTA.astro';

interface LinkItem {
  href: string;
  label: string;
}

interface RelatedItem {
  href: string;
  title: string;
  description: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  navItems: LinkItem[];
  breadcrumbs: LinkItem[];
  related?: RelatedItem[];
  ctaTitle?: string;
  ctaDescription?: string;
  primaryCta: LinkItem;
  secondaryCta?: LinkItem;
}

const {
  title,
  description,
  eyebrow,
  navItems,
  breadcrumbs,
  related = [],
  ctaTitle = 'If the growth problem is bigger than one campaign, fix the system behind it.',
  ctaDescription = 'Use this page as a diagnostic lens, then move into a growth audit or strategy call to identify the highest-leverage next move.',
  primaryCta,
  secondaryCta,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <PillarSectionNav items={navItems} rootHref="/restaurant-cafe-growth-systems/" />

  <article class="section-shell pt-4 md:pt-8">
    <PillarBreadcrumbs items={breadcrumbs} />

    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[minmax(0,0.72fr)_minmax(19rem,0.28fr)] lg:gap-16">
      <div class="max-w-[760px]">
        <p class="mono-label mb-5">{eyebrow}</p>
        <h1 class="hero-title max-w-[12ch]">
          {title}
        </h1>
        <p class="body-lead mt-7 max-w-[680px]">
          {description}
        </p>
        <div class="my-12 h-px w-14 bg-accent"></div>
        <div class="growth-detail-body space-y-12">
          <slot />
        </div>
      </div>

      <aside class="lg:pt-16">
        <div class="proof-card sticky top-8 p-6">
          <div class="relative z-10">
          <p class="mono-label mb-4">Best next moves</p>
          <div class="space-y-3">
            <a href={primaryCta.href} class="block text-sm text-text hover:text-accent transition-colors no-underline">
              {primaryCta.label} &rarr;
            </a>
            {secondaryCta && (
              <a href={secondaryCta.href} class="block text-sm text-text hover:text-accent transition-colors no-underline">
                {secondaryCta.label} &rarr;
              </a>
            )}
            <a href="/restaurant-cafe-growth-systems/templates/" class="block text-sm text-text hover:text-accent transition-colors no-underline">
              Open templates & trackers &rarr;
            </a>
            <a href="/restaurant-finance/" class="block text-sm text-text hover:text-accent transition-colors no-underline">
              Explore restaurant finance &rarr;
            </a>
          </div>
          </div>
        </div>
      </aside>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section-shell section-pad">
      <div class="mb-10 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="mono-label mb-4">Related pages</p>
          <h2 class="section-title max-w-[14ch]">
            Adjacent parts of the growth system.
          </h2>
        </div>
      </div>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
        {related.map((item) => (
          <PillarResourceCard
            eyebrow="Related"
            title={item.title}
            description={item.description}
            href={item.href}
            metadata="Open page"
          />
        ))}
      </div>
    </section>
  )}

  <PillarCTA
    eyebrow="Next step"
    title={ctaTitle}
    description={ctaDescription}
    primary={primaryCta}
    secondary={secondaryCta}
  />
</BaseLayout>
