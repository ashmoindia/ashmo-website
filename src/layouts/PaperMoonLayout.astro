---
import '../styles/paper-moon.css';

interface Props {
  title?: string;
  description?: string;
  pageKind?: string;
  slug?: string;
}

const {
  title = 'Paper Moon',
  description = 'Make a paper moon. Let someone leave a trace.',
  pageKind = '',
  slug = '',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow,noarchive,nosnippet" />
    <meta name="theme-color" content="#111827" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/pm/icons/icon-192.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/pm/icons/icon-192.png" />
  </head>
  <body data-pm-page={pageKind} data-moon-slug={slug}>
    <a class="pm-skip" href="#paper-moon-main">Skip to Paper Moon</a>
    <main id="paper-moon-main">
      <slot />
    </main>
    <script src="/pm/paper-moon.js" defer></script>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/pm/sw.js', { scope: '/pm/' }).catch(() => {});
        });
      }
    </script>
  </body>
</html>
