---
import BaseLayout from './BaseLayout.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  metaTitle?: string;
  description: string;
  date: Date;
  updated?: Date;
  pillar: string;
  image?: string;
  currentSlug?: string;
}

const { title, metaTitle, description, date, updated, pillar, image, currentSlug } = Astro.props;

// Get related articles (same pillar, excluding current)
const allArticles = await getCollection('thinking', ({ data }) => data.published);
const relatedArticles = allArticles
  .filter(a => a.data.pillar === pillar && a.id !== currentSlug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const pillarLabels: Record<string, string> = {
  'merchant-mindset': 'Commercial Instinct',
  'brand-growth': 'Brand Systems',
  'ai-selling': 'AI-Age Marketing',
  'habit-philosophy': 'Decision Discipline',
  'founder-documentary': 'Founder Clarity',
};

const purplePillars = ['ai-selling', 'habit-philosophy'];
const isPurple = purplePillars.includes(pillar);

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "datePublished": date.toISOString(),
  "dateModified": (updated || date).toISOString(),
  "author": {
    "@type": "Person",
    "name": "Ashraf Hassan",
    "alternateName": "Ashmo",
    "url": "https://ashmo.io/story"
  },
  "publisher": {
    "@type": "Person",
    "name": "Ashraf Hassan",
    "url": "https://ashmo.io"
  },
  "mainEntityOfPage": canonicalURL.toString(),
  ...(image ? { "image": new URL(image, Astro.site).toString() } : {})
};
---

<BaseLayout title={metaTitle || title} description={description} image={image} type="article" publishedDate={date}>

  <!-- Article JSON-LD -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <article class="section-shell pt-10 md:pt-16 pb-20 md:pb-28">
    <div class="max-w-[760px]">

      <!-- Meta -->
      <div class="flex items-center gap-6 mb-10">
        <span
          class="mono-label"
          style={`color: ${isPurple ? 'var(--color-secondary)' : 'var(--color-accent)'}`}
        >
          {pillarLabels[pillar] || pillar}
        </span>
        <span class="w-px h-4 bg-border"></span>
        <span class="text-[0.778rem] text-text-tertiary">{formattedDate}</span>
      </div>

      <p class="text-[0.778rem] uppercase tracking-[0.14em] text-text-tertiary mb-8">
        By <a href="/story/" class="text-accent hover:text-accent-light">Ashraf Hassan (Ashmo)</a>
      </p>

      <!-- Title -->
      <h1 class="hero-title mb-8 max-w-[12ch]">
        {title}
      </h1>

      <!-- Lead -->
      <p class="text-xl md:text-[1.22rem] text-text-secondary leading-relaxed font-light mb-12 max-w-[600px]">
        {description}
      </p>

      <!-- Separator -->
      <div class="w-12 h-px mb-12" style={`background: ${isPurple ? 'var(--color-secondary)' : 'var(--color-accent)'}`}></div>

      <!-- Body -->
      <div class="prose">
        <slot />
      </div>

      <!-- Author -->
      <div class="cta-panel mt-20 p-5 md:p-6">
        <div class="relative z-10 flex items-center gap-5">
        <div class="w-12 h-12 rounded-full bg-white/[0.04] border border-white/10 flex items-center justify-center text-xs text-text-tertiary">A</div>
        <div>
          <p class="text-[0.889rem] font-medium text-text">Ashraf Hassan (Ashmo)</p>
          <p class="text-sm text-text-tertiary">Commercial strategist, brand builder, and writer. <a href="/story/" class="text-accent hover:text-accent-light">About Ashmo</a></p>
        </div>
        </div>
      </div>

      <!-- Related Articles -->
      {relatedArticles.length > 0 && (
        <div class="mt-16">
          <h2 class="mono-label mb-8">Keep Reading</h2>
          <div class="flex flex-col gap-6">
            {relatedArticles.map(article => (
              <a href={`/thinking/${article.id}/`} class="feature-card hover-lift group block p-5 no-underline">
                <div class="relative z-10">
                <h3 class="font-heading text-lg font-semibold text-text group-hover:text-accent transition-colors mb-1">{article.data.title}</h3>
                <p class="text-sm text-text-tertiary font-light">{article.data.description}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

    </div>
  </article>

</BaseLayout>
