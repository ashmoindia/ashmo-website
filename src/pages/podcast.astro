---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { podcastEpisodes } from '../data/podcast';

const purplePillars = ['ai-selling', 'habit-philosophy'];
---

<BaseLayout title="Conversations — Brand & Growth" description="Long-form conversations and public notes on F&B growth, founder clarity, AI-age execution, brand systems, and commercial judgment.">

  <PageHero
    eyebrow="Conversations"
    title="Conversations on brand, growth, and"
    highlight="commercial judgment."
    description="Long-form conversations and public notes on F&B growth, founder clarity, AI-age execution, and the discipline behind building brands."
    primary={{ href: '#episodes', label: podcastEpisodes.length > 1 ? 'Watch episodes' : 'Watch conversation' }}
    secondary={{ href: '/thinking/', label: 'Browse Insights' }}
    stats={[
      { value: String(podcastEpisodes.length), label: 'episodes' },
      { value: 'Brand', label: 'themes' },
      { value: 'Founders', label: 'lens' },
    ]}
    sideEyebrow="Format"
    sideTitle="Useful conversations, not performance clips."
    sideDescription="The conversations layer sits beside the insights: slower, more direct, and built around practical business judgment."
  />

  <section id="episodes" class="section-shell pb-24 md:pb-32">
    <div class="mb-10">
      <p class="mono-label mb-4">{podcastEpisodes.length > 1 ? 'Conversation archive' : 'Featured conversation'}</p>
      <h2 class="section-title max-w-[12ch]">
        {podcastEpisodes.length > 1 ? 'Long-form talks on brand and growth.' : 'One useful conversation, clearly presented.'}
      </h2>
    </div>
    <div class="flex flex-col gap-12">
      {podcastEpisodes.map(ep => (
        <article class="feature-card overflow-hidden">
          <!-- Video Embed -->
          <div class="relative z-10 aspect-video w-full">
            <iframe
              src={`https://www.youtube.com/embed/${ep.youtubeId}`}
              title={ep.title}
              class="w-full h-full"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>

          <!-- Episode Info -->
          <div class="relative z-10 p-8 md:p-10">
            <div class="flex items-center gap-4 mb-4">
              <span
                class="font-mono text-[0.667rem] font-semibold uppercase tracking-[0.08em]"
                style={`color: ${purplePillars.includes(ep.pillar) ? 'var(--color-secondary)' : 'var(--color-accent)'}`}
              >
                {ep.show}
              </span>
              <span class="text-[0.667rem] text-text-tertiary">{ep.episode}</span>
            </div>

            <h2 class="text-xl font-bold leading-tight md:text-2xl">
              {ep.title}
            </h2>

            <p class="mt-4 text-[0.944rem] leading-relaxed text-text-secondary">
              {ep.description}
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>

</BaseLayout>
