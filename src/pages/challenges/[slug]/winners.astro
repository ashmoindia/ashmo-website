---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import {
  entryStatusLabels,
  type Challenge,
} from '../../../data/challenges';
import { getChallenges, getWinnerEntriesForChallenge } from '../../../lib/challenge-data';

export async function getStaticPaths() {
  const challenges = await getChallenges({ publicOnly: true });
  return challenges.map((challenge) => ({
    params: { slug: challenge.slug },
    props: { challenge },
  }));
}

interface Props {
  challenge: Challenge;
}

const { challenge } = Astro.props;
const winners = await getWinnerEntriesForChallenge(challenge.id);
const breadcrumbs = [
  { name: 'Challenges', href: '/challenges/' },
  { name: challenge.title, href: `/challenges/${challenge.slug}/` },
  { name: 'Winners', href: `/challenges/${challenge.slug}/winners/` },
];
---

<BaseLayout
  title={`${challenge.title} Winners`}
  description={`Finalists and winners for ${challenge.title}.`}
  breadcrumbs={breadcrumbs}
>
  <section class="section-shell pt-10 md:pt-14 pb-14 md:pb-18">
    <Breadcrumbs items={breadcrumbs} />

    <div class="mt-10 max-w-[760px]">
      <p class="mono-label mb-5">Winner archive</p>
      <h1 class="hero-title max-w-[12ch]">Finalists worth remembering.</h1>
      <p class="body-lead mt-7 max-w-[48rem]">
        The public record for standout creators from {challenge.title}. This page becomes the shareable showcase after judging closes.
      </p>
    </div>
  </section>

  <section class="section-shell pb-24 md:pb-32">
    {winners.length > 0 ? (
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {winners.map((entry) => (
          <a href={entry.submissionUrl} target="_blank" rel="noopener" class="card-base hover-lift no-underline">
            <article class="relative z-10 flex h-full flex-col p-6 md:p-7">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <span class="rounded-full border border-accent/30 bg-accent/10 px-3 py-1 font-mono text-[0.62rem] uppercase tracking-[0.14em] text-accent-light">
                  {entryStatusLabels[entry.status]}
                </span>
                {entry.score && <span class="font-mono text-[0.62rem] uppercase tracking-[0.14em] text-text-tertiary">{entry.score}/100</span>}
              </div>
              <h2 class="mt-6 font-heading text-[1.75rem] font-bold leading-[1.08] tracking-normal text-text">{entry.participantName}</h2>
              <p class="mt-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-accent-light">@{entry.instagramUsername}</p>
              <p class="mt-5 text-sm leading-[1.75] text-text-secondary">{entry.caption}</p>
              <p class="mt-6 font-mono text-[0.62rem] uppercase tracking-[0.14em] text-text-tertiary">{entry.aiToolsUsed.join(' / ')}</p>
              <span class="mt-auto pt-8 font-mono text-[0.7rem] font-semibold uppercase tracking-[0.06em] text-accent-light">
                View creator entry <span aria-hidden="true">&rarr;</span>
              </span>
            </article>
          </a>
        ))}
      </div>
    ) : (
      <div class="max-w-[680px] rounded-[1.5rem] border border-white/8 bg-white/[0.04] p-6 md:p-8">
        <p class="mono-label mb-4">Pending results</p>
        <h2 class="font-heading text-[2rem] font-bold leading-[1.05] tracking-normal text-text">Winners have not been announced yet.</h2>
        <p class="mt-5 text-[1rem] leading-[1.75] text-text-secondary">
          Finalists will appear here after manual review. Until then, the live challenge page remains the main entry board.
        </p>
        <a href={`/challenges/${challenge.slug}/`} class="button-gradient mt-7">Back to challenge</a>
      </div>
    )}
  </section>
</BaseLayout>
