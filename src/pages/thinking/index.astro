---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PageSection from '../../components/PageSection.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import PageActionPanel from '../../components/PageActionPanel.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

type ThinkingEntry = CollectionEntry<'thinking'>;

const isDefined = (value: ThinkingEntry | undefined): value is ThinkingEntry => Boolean(value);

const allArticles = await getCollection('thinking', ({ data }) => data.published);
const sortedArticles = allArticles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featuredArticle = sortedArticles.find((article) => article.data.featured) ?? sortedArticles[0];
const archiveArticles = featuredArticle
  ? sortedArticles.filter((article) => article.id !== featuredArticle.id)
  : [];

const pillarMeta = {
  'merchant-mindset': {
    label: 'Commercial Instinct',
    description: 'Trade, pricing, attention, and the ground-level mechanics of how people actually buy.',
  },
  'brand-growth': {
    label: 'Brand Systems',
    description: 'Positioning, campaign judgment, consistency, and the decisions that scale without losing the brand.',
  },
  'ai-selling': {
    label: 'AI-Age Marketing',
    description: 'Where modern tools compress execution and where human judgment still matters most.',
  },
  'habit-philosophy': {
    label: 'Decision Discipline',
    description: 'Discipline, patience, decision quality, and the operating psychology behind durable work.',
  },
  'founder-documentary': {
    label: 'Founder Clarity',
    description: 'Cleaner thinking for founders making decisions while the market gets noisy.',
  },
} as const;

const pillarOrder = [
  'merchant-mindset',
  'brand-growth',
  'ai-selling',
  'habit-philosophy',
  'founder-documentary',
] as const;

const pillarSummaries = pillarOrder.map((pillar) => ({
  pillar,
  ...pillarMeta[pillar],
  count: sortedArticles.filter((article) => article.data.pillar === pillar).length,
}));

const entryPointSlugs = [
  'brand-positioning-hardest-thing',
  'grocery-shop-pricing-psychology',
  'ai-marketing-70-outlet-chain',
];

const entryPoints = entryPointSlugs
  .map((slug) => sortedArticles.find((article) => article.id === slug))
  .filter(isDefined);

const articleCount = sortedArticles.length;
const publishedYears = new Set(sortedArticles.map((article) => article.data.date.getFullYear())).size;
const latestPublished = sortedArticles[0]?.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const archiveLinks = [
  { href: '/principles/', label: 'Building Principles', accent: true },
  { href: '/growth/', label: 'Growth Systems' },
  { href: '/work/', label: 'Case Studies' },
];
---

<BaseLayout
  title="Insights — Brand Systems & AI-Age Growth"
  description="Field notes, playbooks, brand breakdowns, market notes, and AI workflows for founders, marketers, and F&B business builders."
>
  <PageHero
    eyebrow="Insights"
    title="Field notes, playbooks, and commercial breakdowns for the"
    highlight="AI-age brand economy."
    description="Practical notes on brand systems, commercial judgment, AI-age marketing, F&B growth, positioning, customer attention, and market behaviour."
    primary={{ href: featuredArticle ? `/thinking/${featuredArticle.id}/` : '/thinking/', label: 'Open lead brief' }}
    secondary={{ href: '/principles/', label: 'Building Principles' }}
    stats={[
      { value: String(articleCount), label: 'published' },
      { value: String(pillarSummaries.length), label: 'pillars' },
      { value: latestPublished ?? 'Latest', label: 'latest' },
    ]}
    sideEyebrow="Insight structure"
    sideTitle="Built around recurring problems, not random posting."
    sideDescription={`${publishedYears}+ active years of writing organized by the patterns that keep showing up in commercial decisions.`}
    sideCards={pillarSummaries.slice(0, 4).map((pillar) => ({
      eyebrow: `${pillar.label} / ${pillar.count}`,
      description: pillar.description,
    }))}
  />

  {featuredArticle && (
    <PageSection
      eyebrow="Lead brief"
      title="The clearest entry into the"
      highlight="insights"
      suffix="right now."
      description="One piece up front. The rest of the insights follow. The goal is to help someone enter the thinking quickly, not make them guess where to start."
      spacing="tight"
    >
      <div class="mt-10">
        <ArticleCard
          title={featuredArticle.data.title}
          description={featuredArticle.data.description}
          date={featuredArticle.data.date}
          pillar={featuredArticle.data.pillar}
          tags={featuredArticle.data.tags}
          slug={featuredArticle.id}
          featured={true}
          headingLevel="h2"
        />
      </div>
    </PageSection>
  )}

  <PageSection
    eyebrow="Entry points"
    title="Three places to start if you want the"
    highlight="lens fast."
    description="These pieces explain the platform from three angles: positioning, commercial instinct, and AI-age execution."
    spacing="tight"
  >
    <FeatureGrid
      columns="3"
      items={entryPoints.map((article) => ({
        eyebrow: pillarMeta[article.data.pillar].label,
        title: article.data.title,
        description: article.data.description,
        href: `/thinking/${article.id}/`,
        metadata: 'Start here',
      }))}
    />
  </PageSection>

  <PageSection
    eyebrow="Insight library"
    title="The rest of the notes, arranged to be browsed instead of"
    highlight="endured."
    description="The library leans editorial on purpose. Fewer boxes shouting at once. More visual calm, stronger hierarchy, and clearer context around each piece."
  >
    {archiveArticles.length > 0 ? (
      <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
        {archiveArticles.map((article) => (
          <ArticleCard
            title={article.data.title}
            description={article.data.description}
            date={article.data.date}
            pillar={article.data.pillar}
            tags={article.data.tags}
            slug={article.id}
            headingLevel="h3"
          />
        ))}
      </div>
    ) : (
      <p class="mt-10 text-text-secondary font-light">Notes coming soon.</p>
    )}
  </PageSection>

  <PageActionPanel
    eyebrow="Next layer"
    title="The insights connect best beside the"
    highlight="principles"
    suffix="and the work."
    description="The writing explains the judgments. The principles explain the building beliefs. The case studies show where those beliefs were tested."
    primary={archiveLinks[0]}
    secondary={archiveLinks[1]}
  />
</BaseLayout>
