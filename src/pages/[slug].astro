---
import BaseLayout from '../layouts/BaseLayout.astro';
import PillarCTA from '../components/PillarCTA.astro';
import PillarResourceCard from '../components/PillarResourceCard.astro';
import {
  getRestaurantSeoHref,
  getRestaurantSeoPage,
  restaurantSeoBaseUrl,
  restaurantSeoPages,
} from '../data/restaurantSeoPages';

export async function getStaticPaths() {
  return restaurantSeoPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const related = page.relatedSlugs
  .map((slug: string) => getRestaurantSeoPage(slug))
  .filter(Boolean)
  .map((item) => ({
    href: getRestaurantSeoHref(item!.slug),
    title: item!.title,
    description: item!.metaDescription,
    eyebrow: item!.cluster,
  }));

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': page.cluster.includes('commercial') || page.slug.includes('consultant') || page.slug.includes('agency') ? 'Service' : 'Article',
  headline: page.title,
  name: page.title,
  description: page.metaDescription,
  mainEntityOfPage: `${restaurantSeoBaseUrl}${getRestaurantSeoHref(page.slug)}`,
  url: `${restaurantSeoBaseUrl}${getRestaurantSeoHref(page.slug)}`,
  author: {
    '@type': 'Person',
    name: 'Ashraf Hassan',
    alternateName: 'Ashmo',
    url: `${restaurantSeoBaseUrl}/ashraf-hassan/`,
  },
  publisher: {
    '@type': 'Organization',
    name: 'ASHMO.IO',
    url: restaurantSeoBaseUrl,
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  type="article"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Restaurant & Cafe Growth Systems', href: '/restaurant-cafe-growth-systems/' },
    { name: page.keyword, href: getRestaurantSeoHref(page.slug) },
  ]}
  extraSchema={[articleSchema, faqSchema]}
>
  <article>
    <section class="section-shell pt-12 pb-14 md:pt-18 md:pb-20">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.72fr)_minmax(18rem,0.28fr)] lg:gap-16">
        <div>
          <p class="mono-label mb-5">{page.cluster} / Priority {page.priority}</p>
          <h1 class="hero-title max-w-[14ch]">{page.title}</h1>
          <div class="mt-7 max-w-[47rem] space-y-5">
            {page.intro.map((paragraph: string) => (
              <p class="body-lead">{paragraph}</p>
            ))}
          </div>
          <div class="mt-9 flex flex-col gap-4 sm:flex-row">
            <a href={page.ctaHref} class="button-gradient">
              {page.ctaLabel}
              <span aria-hidden="true">&rarr;</span>
            </a>
            <a href="/restaurant-cafe-growth-systems/" class="button-secondary">
              Explore Growth Systems
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <aside class="lg:pt-10">
          <div class="proof-card sticky top-8 p-6">
            <div class="relative z-10">
              <p class="mono-label mb-4">Search intent</p>
              <p class="text-[1.6rem] font-bold leading-[1.05] text-text">{page.keyword}</p>
              <p class="mt-5 text-[0.95rem] leading-[1.75] text-text-secondary">
                Built as a practical commercial page for founders, operators, and marketers who need decisions, not generic tactics.
              </p>
              <div class="mt-6 space-y-3 text-sm">
                <a class="block text-text no-underline transition-colors hover:text-accent" href="#framework">Framework &rarr;</a>
                <a class="block text-text no-underline transition-colors hover:text-accent" href="#checklist">Checklist &rarr;</a>
                <a class="block text-text no-underline transition-colors hover:text-accent" href="#faqs">FAQs &rarr;</a>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section class="section-shell pb-14 md:pb-20">
      <div class="grid gap-6 lg:grid-cols-[0.42fr_0.58fr] lg:gap-10">
        <div>
          <p class="mono-label mb-4">Problem framing</p>
          <h2 class="section-title max-w-[13ch]">Why generic advice fails here.</h2>
        </div>
        <div class="feature-card p-6 md:p-7">
          <div class="relative z-10">
            <p class="text-[1.08rem] leading-[1.85] text-text-secondary">{page.failurePoint}</p>
          </div>
        </div>
      </div>
    </section>

    <section id="framework" class="section-shell pb-14 md:pb-20">
      <div class="mb-9">
        <p class="mono-label mb-4">ASHMO.IO framework</p>
        <h2 class="section-title max-w-[15ch]">The operator logic behind the page.</h2>
      </div>
      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {page.framework.map((item: string, index: number) => (
          <div class="feature-card p-5">
            <div class="relative z-10">
              <p class="mono-label mb-3">Layer {String(index + 1).padStart(2, '0')}</p>
              <p class="text-[0.98rem] leading-[1.75] text-text-secondary">{item}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="checklist" class="section-shell pb-14 md:pb-20">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.55fr)_minmax(0,0.45fr)]">
        <div>
          <p class="mono-label mb-4">Practical checklist</p>
          <h2 class="section-title max-w-[14ch]">Use this before spending more.</h2>
          <ul class="mt-8 space-y-3 list-none p-0">
            {page.checklist.map((item: string) => (
              <li class="rounded-[1rem] border border-border bg-surface/60 px-4 py-4 text-[0.96rem] font-light leading-[1.7] text-text-secondary">
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="proof-card p-6 md:p-7">
          <div class="relative z-10">
            <p class="mono-label mb-4">Operator example</p>
            <p class="text-[1.08rem] leading-[1.82] text-text-secondary">{page.example}</p>
            {page.localAngle && (
              <>
                <div class="my-6 h-px w-14 bg-accent"></div>
                <p class="mono-label mb-4">Dubai / UAE angle</p>
                <p class="text-[0.98rem] leading-[1.8] text-text-secondary">{page.localAngle}</p>
              </>
            )}
          </div>
        </div>
      </div>
    </section>

    <section id="faqs" class="section-shell pb-14 md:pb-20">
      <div class="mb-9">
        <p class="mono-label mb-4">FAQs</p>
        <h2 class="section-title max-w-[16ch]">Questions operators usually ask.</h2>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        {page.faqs.map((faq) => (
          <div class="rounded-[1.2rem] border border-border bg-surface/70 px-5 py-5">
            <h3 class="font-heading text-[1.2rem] leading-[1.12] text-text">{faq.question}</h3>
            <p class="mt-3 text-[0.95rem] font-light leading-[1.75] text-text-secondary">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section-shell section-pad">
      <div class="mb-9">
        <p class="mono-label mb-4">Internal links</p>
        <h2 class="section-title max-w-[15ch]">Related pages in the growth system.</h2>
      </div>
      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {related.map((item) => (
          <PillarResourceCard
            eyebrow={item.eyebrow}
            title={item.title}
            description={item.description}
            href={item.href}
            metadata="Open guide"
          />
        ))}
      </div>
    </section>
  </article>

  <PillarCTA
    eyebrow="Next step"
    title="If the page describes the problem you are seeing, diagnose the system before adding more tactics."
    description="ASHMO.IO connects positioning, local demand, launch discipline, delivery, CRM, and dashboards into practical restaurant and cafe growth systems."
    primary={{ href: page.ctaHref, label: page.ctaLabel }}
    secondary={{ href: '/restaurant-cafe-growth-systems/templates/', label: 'Open templates' }}
  />
</BaseLayout>
