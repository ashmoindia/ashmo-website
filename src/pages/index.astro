---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroExchange from '../components/HeroExchange.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { featuredPodcastEpisode } from '../data/podcast';
import { financeCalculators, financeTemplates } from '../data/restaurantFinance';
import {
  growthAuditPath,
  growthFrameworkLayers,
  growthTemplates,
  growthToolkitBundlePath,
} from '../data/restaurantGrowth';

type ThinkingEntry = CollectionEntry<'thinking'>;
type WorkEntry = CollectionEntry<'work'>;
type HomeEntry = ThinkingEntry | WorkEntry;

const isDefined = <T,>(value: T | undefined | null): value is T => Boolean(value);

const allArticles = await getCollection('thinking', ({ data }) => data.published);
const allWork = await getCollection('work', ({ data }) => data.published);

const sortedArticles = allArticles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const sortedWork = allWork.sort((a, b) => {
  if (a.id === 'filli-cafe') return -1;
  if (b.id === 'filli-cafe') return 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});

const articleById = new Map(sortedArticles.map((article) => [article.id, article]));
const workById = new Map(sortedWork.map((entry) => [entry.id, entry]));

const featuredArticles = [
  'brand-positioning-hardest-thing',
  'the-ai-tools-that-actually-saved-me-time',
  'most-campaigns-fail-before-the-creative-is-made',
]
  .map((slug) => articleById.get(slug))
  .filter(isDefined);

const caseStudies = [
  workById.get('filli-cafe'),
  workById.get('ashmo-platform'),
  workById.get('the-podcast'),
]
  .filter(isDefined);

const latestArticle = sortedArticles[0];
const frameworkPreview = growthFrameworkLayers.slice(0, 4);
const featuredGrowthTemplates = growthTemplates.slice(0, 2);
const featuredFinanceTemplates = financeTemplates.slice(0, 2);

const pillarLabels: Record<string, string> = {
  'merchant-mindset': 'Merchant Mindset',
  'brand-growth': 'Brand Growth',
  'ai-selling': 'AI & Selling',
  'habit-philosophy': 'Habit Philosophy',
  'founder-documentary': 'Founder Documentary',
};

const categoryLabels: Record<string, string> = {
  'brand-building': 'Brand Building',
  'founder-documentary': 'Founder Documentary',
  'merchant-mindset': 'Merchant Mindset',
};

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });

const getHref = (entry?: HomeEntry) => {
  if (!entry) return '/thinking/';
  return entry.collection === 'work'
    ? `/work/${entry.id}/`
    : `/thinking/${entry.id}/`;
};

const getLabel = (entry: HomeEntry) => {
  return entry.collection === 'work'
    ? (categoryLabels[entry.data.category] || entry.data.category)
    : (pillarLabels[entry.data.pillar] || entry.data.pillar);
};

const featuredPodcastWatchUrl = `https://www.youtube.com/watch?v=${featuredPodcastEpisode.youtubeId}`;

const proofCards = [
  {
    value: '100+',
    label: 'stores and outlets',
    description: 'Lessons from growing real cafes, stores, teams, campaigns, and customer habits across daily business life.',
  },
  {
    value: '13',
    label: 'countries',
    description: 'A practical view of what changes when a brand moves across cities, cultures, landlords, malls, and markets.',
  },
  {
    value: '25',
    label: 'years in business',
    description: 'Merchant instincts from years of buying, selling, pricing, promoting, hiring, and dealing with real customers.',
  },
];

const osCards = [
  {
    title: 'Customers',
    description: 'Understand why people walk in, why they leave, what they remember, and what brings them back.',
  },
  {
    title: 'Sales',
    description: 'Look at offers, pricing, menu choices, service gaps, and simple actions that can improve daily revenue.',
  },
  {
    title: 'Marketing',
    description: 'Make ads, posts, launches, and local promotions easier to understand and easier for customers to act on.',
  },
  {
    title: 'Growth',
    description: 'Separate busy work from work that improves repeat visits, margins, reviews, and long-term trust.',
  },
];

const productCards = [
  {
    eyebrow: 'Templates',
    title: 'Restaurant Growth Files',
    description: `${growthTemplates.length} practical workbooks for planning promotions, tracking sales, opening stores, improving menus, reviewing delivery, and keeping marketing tied to real business results.`,
    href: growthToolkitBundlePath,
    cta: 'Download files',
    meta: 'Excel files · v3',
  },
  {
    eyebrow: 'Money',
    title: 'Restaurant Finance Files',
    description: `${financeTemplates.length} templates and ${financeCalculators.length} calculators to help owners see rent, wages, delivery costs, break-even points, and profit before decisions get expensive.`,
    href: '/restaurant-finance/templates/',
    cta: 'Open files',
    meta: 'Templates and calculators',
  },
  {
    eyebrow: 'Review',
    title: 'Business Growth Review',
    description: 'A simple starting point for owners who want a clearer view of their brand, sales, local demand, marketing, delivery, and repeat customers.',
    href: `${growthAuditPath}#growth-audit-form`,
    cta: 'Request review',
    meta: 'Owner intake',
  },
];
---

<BaseLayout
  title="Home"
  description="Ashraf Hassan, known as Ashmo, shares practical business lessons for merchants, shopkeepers, restaurants, cafes, and growing brands."
>
  <section class="section-shell pt-14 pb-18 md:pt-20 md:pb-24">
    <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,0.95fr)_minmax(360px,1.05fr)] lg:gap-14">
      <div>
        <p class="mono-label mb-5">Ashraf Hassan / Ashmo.io / Business growth</p>
        <h1 class="hero-title">
          Practical growth ideas for restaurants, cafes, shops, and small businesses.
        </h1>
        <p class="body-lead mt-7 max-w-[42rem]">
          Plain business thinking for owners who want more customers, better sales, clearer pricing, and marketing that people understand.
        </p>

        <div class="mt-9 flex flex-col gap-4 sm:flex-row">
          <a href="/restaurant-cafe-growth-systems/" class="button-gradient">
            Explore growth ideas
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a href={latestArticle ? getHref(latestArticle) : '/thinking/'} class="button-secondary">
            Read latest thinking
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="mt-9 grid grid-cols-3 gap-3 max-w-[34rem]">
          {proofCards.map((item) => (
            <div class="rounded-[1.2rem] border border-white/8 bg-white/[0.04] px-4 py-4">
              <p class="font-mono text-[1.45rem] font-bold leading-none text-text">{item.value}</p>
              <p class="mt-2 font-mono text-[0.62rem] uppercase tracking-[0.06em] text-text-tertiary">{item.label}</p>
            </div>
          ))}
        </div>
      </div>

      <HeroExchange />

    </div>
  </section>

  <section class="section-shell pb-18 md:pb-24">
    <div class="grid gap-4 md:grid-cols-3">
      {proofCards.map((item) => (
        <article class="proof-card hover-lift p-6 md:p-7">
          <div class="relative z-10">
            <p class="font-mono text-[2.4rem] font-bold leading-none text-text">{item.value}</p>
            <p class="mt-3 mono-label">{item.label}</p>
            <p class="mt-5 text-[0.98rem] leading-[1.75] text-text-secondary">{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section-shell section-pad">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,0.45fr)_minmax(0,0.55fr)] lg:gap-12">
      <div>
        <p class="mono-label mb-4">Business growth</p>
        <h2 class="section-title max-w-[12ch]">Simple ideas for better business decisions.</h2>
        <p class="body-lead mt-6 max-w-[34rem]">
          This is for merchants, shopkeepers, and F&amp;B owners who want practical advice on customers, sales, marketing, pricing, and repeat business.
        </p>
        <a href="/thinking/ai-marketing-70-outlet-chain/" class="button-text mt-7">
          Read a practical business note
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {osCards.map((card) => (
          <article class="feature-card hover-lift p-6">
            <div class="relative z-10">
              <p class="mono-label">{card.title}</p>
              <p class="mt-4 text-[0.96rem] leading-[1.75] text-text-secondary">{card.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell pb-18 md:pb-24">
    <div class="card-base gradient-border p-6 md:p-8 lg:p-10">
      <div class="relative z-10 grid gap-8 lg:grid-cols-[0.72fr_1fr] lg:items-end">
        <div>
          <p class="mono-label mb-4">What gets covered</p>
          <h2 class="section-title max-w-[12ch]">The everyday work behind growth.</h2>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {frameworkPreview.map((layer) => (
            <div class="rounded-[1.25rem] border border-white/8 bg-white/[0.04] p-5">
              <p class="font-mono text-[0.68rem] uppercase tracking-[0.06em] text-accent-light">{layer.title}</p>
              <p class="mt-3 text-sm leading-[1.72] text-text-secondary">{layer.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section-shell section-pad">
    <div class="mb-10 flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="mono-label mb-4">Files and templates</p>
        <h2 class="section-title max-w-[13ch]">Useful files for owners who need clarity.</h2>
      </div>
      <p class="max-w-[31rem] text-[0.98rem] leading-[1.75] text-text-secondary">
        Downloadable files and review paths for restaurant, cafe, and food business decisions that owners make every week.
      </p>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      {productCards.map((product) => (
        <a href={product.href} class="product-card hover-lift flex h-full flex-col p-6 no-underline md:p-7">
          <div class="relative z-10 flex h-full flex-col">
            <div class="flex items-start justify-between gap-4">
              <p class="mono-label">{product.eyebrow}</p>
              <span class="rounded-full border border-white/8 bg-white/[0.04] px-3 py-1 font-mono text-[0.62rem] uppercase tracking-[0.06em] text-text-tertiary">
                {product.meta}
              </span>
            </div>
            <h3 class="mt-8 text-[1.55rem] font-bold leading-[1.08] text-text">{product.title}</h3>
            <p class="mt-4 text-[0.96rem] leading-[1.75] text-text-secondary">{product.description}</p>
            <span class="mt-8 inline-flex items-center gap-2 font-mono text-[0.72rem] font-semibold uppercase tracking-[0.06em] text-accent-light">
              {product.cta} <span aria-hidden="true">&rarr;</span>
            </span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-5 grid gap-4 md:grid-cols-4">
      {[...featuredGrowthTemplates, ...featuredFinanceTemplates].map((template) => (
        <a href={template.href} class="rounded-[1.2rem] border border-white/8 bg-white/[0.035] p-5 no-underline transition-all duration-200 hover:-translate-y-1 hover:border-accent/40 hover:bg-white/[0.055]">
          <p class="font-mono text-[0.64rem] uppercase tracking-[0.06em] text-text-tertiary">{template.format}</p>
          <p class="mt-3 text-sm font-semibold leading-[1.35] text-text">{template.name}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section-shell section-pad">
    <div class="mb-10 flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="mono-label mb-4">Case studies</p>
        <h2 class="section-title max-w-[12ch]">Proof from work that had to hold up.</h2>
      </div>
      <a href="/work/" class="button-secondary">View all work <span aria-hidden="true">&rarr;</span></a>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      {caseStudies.map((entry) => (
        <a href={getHref(entry)} class="case-card hover-lift flex min-h-[22rem] flex-col p-6 no-underline md:p-7">
          <div class="relative z-10 flex h-full flex-col">
            <p class="mono-label">{getLabel(entry)}</p>
            <h3 class="mt-8 text-[1.7rem] font-bold leading-[1.08] text-text">{entry.data.title}</h3>
            <p class="mt-4 text-[0.96rem] leading-[1.75] text-text-secondary">{entry.data.description}</p>
            <div class="mt-auto flex items-center justify-between gap-4 pt-8">
              <span class="font-mono text-[0.68rem] uppercase tracking-[0.06em] text-text-tertiary">{formatDate(entry.data.date)}</span>
              <span class="font-mono text-sm text-accent-light" aria-hidden="true">&nearr;</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section-shell pb-18 md:pb-24">
    <div class="card-base gradient-border overflow-hidden">
      <div class="relative z-10 grid gap-8 p-6 md:p-8 lg:grid-cols-[minmax(0,0.42fr)_minmax(0,0.58fr)] lg:items-center lg:p-10">
        <div>
          <p class="mono-label mb-4">Featured conversation</p>
          <h2 class="section-title max-w-[12ch]">{featuredPodcastEpisode.title}</h2>
          <p class="mt-5 text-[0.98rem] leading-[1.78] text-text-secondary">
            A plain conversation on cafe growth, business discipline, customer habits, and what separates strong owners from owners who stay stuck.
          </p>
          <p class="mt-4 font-mono text-[0.68rem] uppercase tracking-[0.06em] text-text-tertiary">
            {featuredPodcastEpisode.show} {featuredPodcastEpisode.episode} / {featuredPodcastEpisode.date}
          </p>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row">
            <a href={featuredPodcastWatchUrl} target="_blank" rel="noopener" class="button-gradient">
              Watch on YouTube
              <span aria-hidden="true">&rarr;</span>
            </a>
            <a href="/podcast/" class="button-secondary">
              Podcast archive
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <div class="overflow-hidden rounded-[1.4rem] border border-white/10 bg-bg-deep shadow-2xl">
          <div class="aspect-video w-full">
            <iframe
              src={`https://www.youtube.com/embed/${featuredPodcastEpisode.youtubeId}`}
              title={featuredPodcastEpisode.title}
              class="h-full w-full"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="border-t border-white/8 bg-white/[0.025] px-5 py-5 md:px-6">
            <p class="mono-label">{featuredPodcastEpisode.show}</p>
            <p class="mt-3 text-sm leading-[1.72] text-text-secondary">{featuredPodcastEpisode.description}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-shell section-pad">
    <div class="mb-10 flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="mono-label mb-4">Thinking</p>
        <h2 class="section-title max-w-[12ch]">Business notes without the jargon.</h2>
      </div>
      <a href="/thinking/" class="button-secondary">Open archive <span aria-hidden="true">&rarr;</span></a>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      {featuredArticles.map((article) => (
        <a href={getHref(article)} class="blog-card hover-lift flex h-full flex-col p-6 no-underline md:p-7">
          <div class="relative z-10 flex h-full flex-col">
            <div class="flex items-start justify-between gap-4">
              <p class="mono-label">{getLabel(article)}</p>
              <span class="font-mono text-[0.68rem] uppercase tracking-[0.06em] text-text-tertiary">{formatDate(article.data.date)}</span>
            </div>
            <h3 class="mt-8 text-[1.55rem] font-bold leading-[1.1] text-text">{article.data.title}</h3>
            <p class="mt-4 text-[0.96rem] leading-[1.75] text-text-secondary">{article.data.description}</p>
            <span class="mt-auto pt-8 font-mono text-[0.72rem] font-semibold uppercase tracking-[0.06em] text-accent-light">
              Read essay <span aria-hidden="true">&rarr;</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section-shell pb-18 md:pb-24">
    <div class="card-base gradient-border p-6 md:p-8 lg:p-10">
      <div class="relative z-10">
        <p class="mono-label mb-4">Market notes</p>
        <h2 class="section-title max-w-[14ch]">What business owners should watch in the GCC.</h2>
        <p class="body-lead mt-5 max-w-[44rem]">
          Clear notes on restaurants, cafes, delivery, pricing, tourism, and customer demand across the GCC. Written for owners, not analysts.
        </p>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <a href="/intelligence/" class="rounded-[1.25rem] border border-white/8 bg-white/[0.04] p-5 no-underline transition-colors hover:border-white/20 hover:bg-white/[0.07]">
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.06em] text-accent-light">All market notes</p>
            <p class="mt-3 text-[1.1rem] font-semibold leading-snug text-text">Hub &amp; index</p>
            <p class="mt-2 text-sm leading-[1.6] text-text-tertiary">Reports, countries, and topics in one place.</p>
          </a>
          <a href="/intelligence/countries/uae/" class="rounded-[1.25rem] border border-white/8 bg-white/[0.04] p-5 no-underline transition-colors hover:border-white/20 hover:bg-white/[0.07]">
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.06em] text-accent-light">UAE</p>
            <p class="mt-3 text-[1.1rem] font-semibold leading-snug text-text">United Arab Emirates</p>
            <p class="mt-2 text-sm leading-[1.6] text-text-tertiary">Dubai &amp; Abu Dhabi notes for restaurant and cafe owners.</p>
          </a>
          <a href="/intelligence/countries/saudi-arabia/" class="rounded-[1.25rem] border border-white/8 bg-white/[0.04] p-5 no-underline transition-colors hover:border-white/20 hover:bg-white/[0.07]">
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.06em] text-accent-light">KSA</p>
            <p class="mt-3 text-[1.1rem] font-semibold leading-snug text-text">Saudi Arabia</p>
            <p class="mt-2 text-sm leading-[1.6] text-text-tertiary">Useful signs from food, hospitality, malls, and city growth across KSA.</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-shell pb-18 md:pb-24">
    <div class="cta-panel gradient-border p-6 md:p-8 lg:p-10">
      <div class="relative z-10 grid gap-8 lg:grid-cols-[minmax(0,0.75fr)_minmax(320px,0.55fr)] lg:items-center">
        <div>
          <p class="mono-label mb-4">Newsletter</p>
          <h2 class="section-title max-w-[13ch]">Get the sharper notes without the noise.</h2>
          <p class="body-lead mt-5 max-w-[40rem]">
            Occasional business notes on customers, pricing, marketing, restaurant growth, and the habits behind durable businesses.
          </p>
        </div>

        <form name="newsletter" method="POST" data-netlify="true" data-netlify-honeypot="bot-field" class="rounded-[1.5rem] border border-white/8 bg-white/[0.04] p-5 md:p-6">
          <input type="hidden" name="form-name" value="newsletter" />
          <p class="hidden"><label>Do not fill this out: <input name="bot-field" /></label></p>
          <label for="newsletter-email" class="font-mono text-[0.68rem] uppercase tracking-[0.06em] text-text-tertiary">
            Email address
          </label>
          <div class="mt-3 flex flex-col gap-3 sm:flex-row">
            <input
              id="newsletter-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
              class="input-dark"
            />
            <button type="submit" class="button-gradient cursor-pointer border-0">
              Subscribe
            </button>
          </div>
          <p class="mt-4 text-xs leading-[1.65] text-text-tertiary">
            No popups. No daily noise. Just useful notes when there is something worth sending.
          </p>
        </form>
      </div>
    </div>
  </section>

  <section class="section-shell pb-24 md:pb-32">
    <div class="grid gap-6 lg:grid-cols-[minmax(0,0.8fr)_minmax(280px,0.42fr)] lg:items-stretch">
      <div class="card-base p-6 md:p-8 lg:p-10">
        <div class="relative z-10">
          <p class="mono-label mb-4">Start here</p>
          <h2 class="section-title max-w-[14ch]">Start with one clearer business decision.</h2>
          <p class="body-lead mt-5 max-w-[44rem]">
            If you run a restaurant, cafe, shop, or growing brand, start with the growth hub and pick the problem closest to your business today.
          </p>
          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a href="/restaurant-cafe-growth-systems/" class="button-gradient">Open growth ideas</a>
            <a href="/contact/" class="button-secondary">Contact Ashmo</a>
          </div>
          <p class="mt-6 font-mono text-[0.72rem] uppercase tracking-[0.06em] text-text-tertiary">
            Written and built by <a href="/ashraf-hassan/" class="text-accent-light no-underline hover:text-accent">Ashraf Hassan (Ashmo)</a> — Dubai · GCC.
          </p>
        </div>
      </div>
      <a href="/story/" class="proof-card hover-lift p-6 no-underline md:p-8">
        <div class="relative z-10 flex h-full flex-col">
          <p class="mono-label">Background</p>
          <h3 class="mt-8 text-[1.7rem] font-bold leading-[1.08] text-text">The long arc behind the work.</h3>
          <p class="mt-4 text-[0.96rem] leading-[1.75] text-text-secondary">
            Grocery shop, design, brand building, FiLLi Cafe, and the business notes now becoming Ashmo.io.
          </p>
          <span class="mt-auto pt-8 font-mono text-[0.72rem] font-semibold uppercase tracking-[0.06em] text-accent-light">
            Read the story <span aria-hidden="true">&rarr;</span>
          </span>
        </div>
      </a>
    </div>
  </section>
</BaseLayout>
