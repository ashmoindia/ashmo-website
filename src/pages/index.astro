---
import BaseLayout from '../layouts/BaseLayout.astro';
import PosterHome from '../components/poster/PosterHome.astro';
import '../styles/poster-theme.css';
---

<BaseLayout
  title="Home"
  description="Commercial intelligence, F&B growth systems, market research, AI-age marketing workflows, and practical business judgment by Ashraf Hassan, known as Ashmo."
  bodyClass="poster-theme poster-theme--light"
>
  <PosterHome />
</BaseLayout>

<script is:inline>
  /* Scroll reveal: content is visible by default; motion-capable browsers get
     the reveal pass after above-the-fold items are marked visible. */
  (function () {
    var d = document;
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    d.documentElement.classList.add('reveal-ready');
    var els = [].slice.call(d.querySelectorAll('.poster-theme [data-reveal]'));
    var vh = window.innerHeight || 800;

    els.forEach(function (el) {
      if (el.getBoundingClientRect().top < vh * 0.92) el.classList.add('is-visible');
    });

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

    els.forEach(function (el) {
      if (!el.classList.contains('is-visible')) io.observe(el);
    });
  })();
</script>
