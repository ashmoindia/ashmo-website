---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PageSection from '../../components/PageSection.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import PageActionPanel from '../../components/PageActionPanel.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getCollection } from 'astro:content';

const allWork = await getCollection('work', ({ data }) => data.published);

const sortedWork = allWork.sort((a, b) => {
  if (a.id === 'filli-cafe') return -1;
  if (b.id === 'filli-cafe') return 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});

const featuredWork = sortedWork[0];
const archiveWork = featuredWork ? sortedWork.filter((item) => item.id !== featuredWork.id) : [];

const categoryMeta = {
  'brand-building': {
    label: 'Brand Systems',
    description: 'Identity systems, positioning, rollout consistency, and the commercial layer underneath brand growth.',
  },
  'founder-documentary': {
    label: 'Platform Build',
    description: 'Projects that document the platform, public-facing systems, and commercial intelligence layer.',
  },
  'merchant-mindset': {
    label: 'Commercial Foundation',
    description: 'Early trade, digital, and creative seasons that built market sense before the brand-building years.',
  },
} as const;

const categoryOrder = ['brand-building', 'merchant-mindset', 'founder-documentary'] as const;

const categorySummaries = categoryOrder.map((category) => ({
  category,
  ...categoryMeta[category],
  count: sortedWork.filter((item) => item.data.category === category).length,
}));

const firstYear = sortedWork.length > 0 ? Math.min(...sortedWork.map((item) => item.data.date.getFullYear())) : new Date().getFullYear();
const latestYear = sortedWork.length > 0 ? Math.max(...sortedWork.map((item) => item.data.date.getFullYear())) : new Date().getFullYear();

const workFrames = [
  {
    label: 'Scale under pressure',
    description: 'What it takes to preserve a brand promise when the business grows faster than intuition can manage on its own.',
  },
  {
    label: 'Commercial pattern recognition',
    description: 'The decisions behind pricing, campaigns, customer behavior, standards, and why some ideas survive repetition while others do not.',
  },
  {
    label: 'Narrative with evidence',
    description: 'A body of work that documents not just what was made, but what had to be understood to make it hold.',
  },
];

const workLinks = [
  { href: '/thinking/', label: 'Browse Insights', accent: true },
  { href: '/story/', label: 'About' },
  { href: '/contact/', label: 'Contact Ashmo' },
];
---

<BaseLayout
  title="Case Studies — Brand Systems"
  description="Selected case studies and working notes from F&B growth, brand systems, product focus, market timing, and commercial execution."
>
  <PageHero
    eyebrow="Case Studies"
    title="Proof from brand systems, growth, and"
    highlight="commercial execution."
    description="Selected work and working notes from F&B growth, brand systems, product focus, market timing, and commercial decision-making."
    primary={{ href: featuredWork ? `/work/${featuredWork.id}/` : '/work/', label: 'Open lead case' }}
    secondary={{ href: '/thinking/', label: 'Browse Insights' }}
    stats={[
      { value: String(sortedWork.length), label: 'case files' },
      { value: `${latestYear - firstYear}+`, label: 'years' },
      { value: `${firstYear}`, label: 'started' },
    ]}
    sideEyebrow="What this section is doing"
    sideTitle="Showing proof without turning the site into a life archive."
    sideDescription="Selected case files and working notes organized by what they reveal about brand systems, growth logic, market timing, and commercial judgment."
    sideCards={categorySummaries.map((category) => ({
      eyebrow: `${category.label} / ${category.count}`,
      description: category.description,
    }))}
  />

  {featuredWork && (
    <PageSection
      eyebrow="Lead case file"
      title="The clearest anchor in the"
      highlight="case study set."
      description="Not because it is the only important project, but because it concentrates the largest number of decisions, repetitions, and consequences in one place."
      spacing="tight"
    >
      <div class="mt-10">
        <WorkCard
          title={featuredWork.data.title}
          description={featuredWork.data.description}
          date={featuredWork.data.date}
          category={featuredWork.data.category}
          tags={featuredWork.data.tags}
          slug={featuredWork.id}
          featured={true}
        />
      </div>
    </PageSection>
  )}

  <PageSection
    eyebrow="Frame"
    title="Three ways to read the archive beyond"
    highlight="projects."
    description="The point is not to showcase output. It is to show what the work reveals about how brands are built, protected, and translated into systems."
    spacing="tight"
  >
    <FeatureGrid columns="3" items={workFrames.map((frame) => ({ title: frame.label, description: frame.description }))} />
  </PageSection>

  <PageSection
    eyebrow="Case study archive"
    title="The rest of the proof, arranged like a"
    highlight="living record."
    description="Each entry should explain a useful commercial capability: brand systems, growth systems, commercial foundation, platform build, public conversation, or market intelligence."
  >
    {archiveWork.length > 0 ? (
      <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
        {archiveWork.map((item) => (
          <WorkCard
            title={item.data.title}
            description={item.data.description}
            date={item.data.date}
            category={item.data.category}
            tags={item.data.tags}
            slug={item.id}
          />
        ))}
      </div>
    ) : (
      <p class="mt-10 text-text-secondary font-light">Case studies coming soon.</p>
    )}
  </PageSection>

  <PageActionPanel
    eyebrow="Keep moving"
    title="The case studies make the most sense beside the"
    highlight="insights."
    description="The proof here is one side of the site. The insights explain the judgment, and the About page explains where that judgment was learned."
    primary={workLinks[0]}
    secondary={workLinks[1]}
  />
</BaseLayout>
