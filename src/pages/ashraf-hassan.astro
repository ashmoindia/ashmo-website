---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { personId, personSchema, websiteId } from '../data/entity';

const profilePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': 'https://ashmo.io/ashraf-hassan/#profile',
  url: 'https://ashmo.io/ashraf-hassan/',
  name: 'Ashraf Hassan (Ashmo)',
  description:
    'Ashraf Hassan, known as Ashmo, is a commercial strategist focused on F&B growth, AI-age marketing, market intelligence, and business judgment.',
  isPartOf: {
    '@id': websiteId,
  },
  about: {
    '@id': personId,
  },
  mainEntity: personSchema,
};
---

<BaseLayout
  title="Ashraf Hassan (Ashmo)"
  description="Ashraf Hassan, known as Ashmo, is a commercial strategist focused on F&B growth, AI-age marketing, market intelligence, and business judgment."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(profilePageSchema)} />

  <PageHero
    eyebrow="Profile"
    title="Ashraf Hassan"
    highlight="Ashmo."
    description="Commercial strategist, brand builder, and writer focused on F&B growth, AI-age marketing systems, market intelligence, and practical business judgment."
    primary={{ href: '/story/', label: 'About Ashmo' }}
    secondary={{ href: '/thinking/', label: 'Browse Insights' }}
    tertiary={{ href: '/contact/', label: 'Contact' }}
    stats={[
      { value: '25+', label: 'years' },
      { value: '100+', label: 'outlets' },
      { value: '13', label: 'countries' },
    ]}
    sideEyebrow="Working lane"
    sideTitle="Brand systems, commercial judgment, and practical writing."
    sideDescription="I write about brand positioning, scaling consumer businesses, founder judgment, pricing psychology, AI-age marketing, and the commercial work that makes a brand easier to remember."
    sideCards={[
      {
        eyebrow: 'What I write about',
        description: 'Brand strategy, commercial instinct, cafe growth, founder discipline, pricing, marketing systems, and UAE restaurant finance.',
      },
      {
        eyebrow: 'Known for',
        description: 'FiLLi Cafe brand building, practical commercial notes, and translating real business pressure into clear writing and decision tools.',
      },
    ]}
  />
</BaseLayout>
