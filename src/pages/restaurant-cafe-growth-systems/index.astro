---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PillarSectionNav from '../../components/PillarSectionNav.astro';
import PillarResourceCard from '../../components/PillarResourceCard.astro';
import PillarCTA from '../../components/PillarCTA.astro';
import {
  growthAuditPath,
  growthBasePath,
  growthBusinessStages,
  growthBusinessTypes,
  growthCapabilities,
  growthFrameworkLayers,
  growthNav,
  growthOffers,
  growthProofBlocks,
  growthResources,
  growthToolkitBundlePath,
  growthTemplatesPath,
} from '../../data/restaurantGrowth';
import { restaurantSeoClusters, getRestaurantSeoHref } from '../../data/restaurantSeoPages';

const credibilityBlocks = [
  {
    tag: 'Revenue logic',
    title: 'Commercially grounded',
    description: 'Channel strategy, campaign systems, content planning, and performance thinking anchored to revenue outcomes.',
  },
  {
    tag: 'Store reality',
    title: 'Execution-tested',
    description: 'Built around footfall, frequency, delivery economics, menu behavior, branch-level momentum, and rollout pressure.',
  },
  {
    tag: 'Compounding model',
    title: 'Growth-system led',
    description: 'The point is not to add more activity. It is to make brand, local demand, retention, and measurement work as one system.',
  },
];

const capabilityPreview = growthCapabilities.slice(0, 12);

const heroProofCards = [
  { value: '8', label: 'growth layers' },
  { value: '12', label: 'core systems' },
  { value: '90', label: 'day plan' },
];

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Restaurant & Cafe Growth Systems',
  description:
    'A strategic growth hub for restaurant, cafe, QSR, and multi-unit brands covering brand, launch, local marketing, delivery, retention, and measurement.',
  url: `https://ashmo.io${growthBasePath}/`,
  hasPart: capabilityPreview.map((item) => ({
    '@type': 'WebPage',
    name: item.title,
    url: `https://ashmo.io${item.href}`,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://ashmo.io/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Restaurant & Cafe Growth Systems',
      item: `https://ashmo.io${growthBasePath}/`,
    },
  ],
};
---

<BaseLayout
  title="Restaurant & Cafe Growth Systems"
  description="Practical growth systems for restaurants, cafes, and founder-driven brands: positioning, local demand, campaigns, CRM, delivery visibility, and measurement."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify([collectionSchema, breadcrumbSchema])} />

  <section class="section-shell pt-14 pb-18 md:pt-20 md:pb-24">
    <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,0.95fr)_minmax(360px,1.05fr)] lg:gap-14">
      <div>
        <p class="mono-label mb-5">Growth Systems</p>
        <h1 class="hero-title">
          Practical growth systems for restaurants, cafes, and <span class="gradient-text">founder-driven brands.</span>
        </h1>
        <p class="body-lead mt-7 max-w-[42rem]">
          Strategy, structure, and decision tools for brands that need better positioning, stronger demand logic, local visibility, campaign discipline, and measurable growth.
        </p>
        <div class="mt-9 flex flex-col gap-4 sm:flex-row">
          <a href={`${growthAuditPath}#strategy-call`} class="button-gradient">
            Request a Growth Review
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a href={growthTemplatesPath} class="button-secondary">
            View Toolkits
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <a href="#frameworks" class="button-text mt-5">
          Explore frameworks &rarr;
        </a>

        <div class="mt-9 grid max-w-[34rem] grid-cols-3 gap-3">
          {heroProofCards.map((item) => (
            <div class="rounded-[1.2rem] border border-white/8 bg-white/[0.04] px-4 py-4">
              <p class="font-mono text-[1.45rem] font-bold leading-none text-text">{item.value}</p>
              <p class="mt-2 font-mono text-[0.62rem] uppercase tracking-[0.06em] text-text-tertiary">{item.label}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="cta-panel gradient-border p-6 md:p-8">
        <div class="relative z-10">
          <div class="border-b border-white/8 pb-6">
            <p class="mono-label mb-4">Commercial strategy lens</p>
            <h2 class="section-title max-w-[12ch] text-[2.2rem] md:text-[2.65rem]">
              Why this reads like growth strategy, not channel chatter.
            </h2>
            <p class="mt-5 max-w-[34rem] text-[0.98rem] leading-[1.78] text-text-secondary">
              The value is not more tactics. It is a tighter way to connect brand, local demand, delivery, retention, and measurement to real operating outcomes.
            </p>
          </div>

          <div class="mt-6 space-y-4">
            {credibilityBlocks.map((block, index) => (
              <div class="grid grid-cols-[auto_1fr] gap-4 rounded-[1.15rem] border border-white/8 bg-white/[0.035] px-4 py-4 md:px-5">
                <div>
                  <span class="flex h-11 w-11 items-center justify-center rounded-[0.95rem] border border-white/10 bg-white/[0.04] font-mono text-[0.7rem] font-semibold uppercase tracking-[0.08em] text-accent-light">
                    0{index + 1}
                  </span>
                </div>
                <div>
                  <p class="mono-label mb-2">{block.tag}</p>
                  <p class="text-[1.22rem] font-bold leading-[1.12] text-text">{block.title}</p>
                  <p class="mt-2 text-[0.95rem] leading-[1.72] text-text-secondary">{block.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <PillarSectionNav items={growthNav} rootHref="/restaurant-cafe-growth-systems/" />

  <section class="section-shell pb-18 md:pb-24">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,0.68fr)_minmax(18rem,0.32fr)] lg:gap-14">
      <div>
        <p class="mono-label mb-4">Why this section exists</p>
        <h2 class="section-title max-w-[16ch]">
          This is built for founders who need growth to survive contact with real restaurant operations.
        </h2>
        <p class="body-lead mt-6 max-w-[46rem]">
          Generic agencies talk about channels. Restaurant teams think about traffic quality, menu mix, trade area, repeat behavior,
          delivery economics, and whether branch-level effort turns into repeatable revenue. This section is built for that reality.
        </p>

        <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2">
          <div class="feature-card p-6">
            <div class="relative z-10">
            <p class="mono-label mb-3">What it positions</p>
            <p class="text-[1.35rem] font-bold leading-[1.12] text-text">A commercially grounded growth strategist.</p>
            <p class="mt-4 text-[0.94rem] leading-[1.75] text-text-secondary">
              Someone who understands branding, launch, store traffic, delivery, CRM, and the commercial pressure behind each move.
            </p>
            </div>
          </div>
          <div class="feature-card p-6">
            <div class="relative z-10">
            <p class="mono-label mb-3">What it avoids</p>
            <p class="text-[1.35rem] font-bold leading-[1.12] text-text">Generic restaurant marketing language.</p>
            <p class="mt-4 text-[0.94rem] leading-[1.75] text-text-secondary">
              No vague “360 solutions.” No channel dumping. No pretending that ads alone fix weak positioning or store economics.
            </p>
            </div>
          </div>
        </div>
      </div>

      <div class="proof-card p-6 md:p-7">
        <div class="relative z-10">
        <p class="mono-label mb-5">Best fit</p>
        <div class="space-y-4">
          <div class="flex gap-3">
            <span class="mt-1 block h-2 w-2 rounded-full bg-accent"></span>
            <p class="text-[0.94rem] leading-[1.75] text-text-secondary">Single-outlet cafes trying to turn local awareness into regulars.</p>
          </div>
          <div class="flex gap-3">
            <span class="mt-1 block h-2 w-2 rounded-full bg-accent"></span>
            <p class="text-[0.94rem] leading-[1.75] text-text-secondary">Independent restaurants that need a sharper commercial marketing plan.</p>
          </div>
          <div class="flex gap-3">
            <span class="mt-1 block h-2 w-2 rounded-full bg-accent"></span>
            <p class="text-[0.94rem] leading-[1.75] text-text-secondary">Premium cafe brands, delivery-first teams, and multi-store groups preparing for scale.</p>
          </div>
        </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-shell section-pad">
      <div class="mb-10 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="mono-label mb-4">By business type</p>
          <h2 class="section-title max-w-[14ch]">
            Start with the business model before choosing the channel.
          </h2>
        </div>
      </div>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
        {growthBusinessTypes.map((item) => (
          <PillarResourceCard
            eyebrow={item.eyebrow}
            title={item.title}
            description={item.description}
            href={item.href}
            metadata={item.metadata}
          />
        ))}
      </div>
  </section>

  <section class="section-shell pb-18 md:pb-24">
    <div class="mb-10 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="mono-label mb-4">By business stage</p>
        <h2 class="section-title max-w-[14ch]">
          Search intent changes as the business changes.
        </h2>
      </div>
    </div>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4">
      {growthBusinessStages.map((item) => (
        <PillarResourceCard
          eyebrow={item.eyebrow}
          title={item.title}
          description={item.description}
          href={item.href}
          metadata="See guidance"
        />
      ))}
    </div>
  </section>

  <section class="section-shell pb-18 md:pb-24">
      <div class="mb-10 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="mono-label mb-4">Core capabilities</p>
          <h2 class="section-title max-w-[15ch]">
            The A-to-Z growth system, not a channel menu.
          </h2>
        </div>
      </div>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
        {capabilityPreview.map((item) => (
          <PillarResourceCard
            eyebrow={item.eyebrow}
            title={item.title}
            description={item.description}
            href={item.href}
            metadata="Open framework"
          />
        ))}
      </div>
  </section>

  <section class="section-shell pb-18 md:pb-24">
    <div class="mb-10 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="mono-label mb-4">SEO growth library</p>
        <h2 class="section-title max-w-[15ch]">
          High-intent restaurant and cafe growth pages.
        </h2>
        <p class="body-lead mt-6 max-w-[44rem]">
          A search-focused content system covering broad authority terms, Dubai consultant intent, cafe growth,
          local SEO, delivery, loyalty, CRM, menu engineering, and KPI dashboards.
        </p>
      </div>
    </div>
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
      {restaurantSeoClusters.map((cluster) => (
        <div class="feature-card p-6">
          <div class="relative z-10">
            <p class="mono-label mb-3">{cluster.pages.length} pages</p>
            <h3 class="text-[1.55rem] font-bold leading-[1.08] text-text">{cluster.cluster}</h3>
            <div class="mt-5 flex flex-wrap gap-3">
              {cluster.pages.map((page) => (
                <a
                  href={getRestaurantSeoHref(page.slug)}
                  class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-2 font-mono text-[0.68rem] font-semibold uppercase tracking-[0.06em] text-text-secondary no-underline transition-colors hover:border-accent/40 hover:text-accent"
                >
                  {page.keyword}
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="frameworks" class="section-shell pb-18 md:pb-24">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,0.5fr)_minmax(0,0.5fr)] lg:gap-14">
      <div>
        <p class="mono-label mb-4">Signature framework</p>
        <h2 class="section-title max-w-[13ch]">
          The 8-layer restaurant growth model.
        </h2>
        <p class="body-lead mt-6 max-w-[40rem]">
          The model is designed to stop founders from treating every growth problem like a traffic problem.
          Each layer affects the next one. When the earlier layers are weak, paid activity becomes expensive and retention becomes fragile.
        </p>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {growthFrameworkLayers.map((layer, index) => (
          <div class="feature-card hover-lift p-5">
            <div class="relative z-10">
            <p class="mono-label mb-3">Layer 0{index + 1}</p>
            <p class="text-[1.12rem] font-bold leading-[1.12] text-text">{layer.title}</p>
            <p class="mt-3 text-[0.92rem] leading-[1.7] text-text-secondary">{layer.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-shell pb-18 md:pb-24">
      <div class="mb-10 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="mono-label mb-4">Templates &amp; trackers</p>
          <h2 class="section-title max-w-[15ch]">
            Decision tools and business workbooks.
          </h2>
        </div>
        <a href={growthTemplatesPath} class="button-text">
          Open full toolkit &rarr;
        </a>
      </div>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
        {growthResources.map((resource) => (
          <PillarResourceCard
            eyebrow={resource.status}
            title={resource.title}
            description={resource.description}
            href={resource.href}
            metadata={resource.metadata ?? 'Open template'}
            accent="soft"
          />
        ))}
      </div>
      <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
        <a href={growthTemplatesPath} class="button-gradient">
          Browse all templates
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a href={growthToolkitBundlePath} download class="button-secondary">
          Download premium toolkit pack
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a href={`${growthAuditPath}#strategy-call`} class="button-secondary">
          Need a custom planning system?
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
  </section>

  <section class="section-shell pb-18 md:pb-24">
    <div class="grid grid-cols-1 gap-10 xl:grid-cols-[minmax(0,0.56fr)_minmax(0,0.44fr)]">
      <div>
        <p class="mono-label mb-4">Proof through thinking</p>
        <h2 class="section-title max-w-[15ch]">
          Strategic insight before polished case-study theater.
        </h2>
        <p class="body-lead mt-6 max-w-[40rem]">
          Even without a public wall of polished case studies, the section can still prove depth through commercial diagnosis,
          campaign logic, launch frameworks, and the way problems are broken down.
        </p>
        <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-2">
          {growthProofBlocks.map((item) => (
            <PillarResourceCard
              eyebrow={item.eyebrow}
              title={item.title}
              description={item.description}
              href={item.href}
              metadata="Read the page"
            />
          ))}
        </div>
      </div>

      <div class="proof-card p-6 md:p-7">
        <div class="relative z-10">
        <p class="mono-label mb-4">Linked commercial intelligence</p>
        <h3 class="text-[2rem] font-bold leading-[1.04] text-text">
          Restaurant finance sits inside the bigger growth picture.
        </h3>
        <p class="mt-5 text-[0.98rem] leading-[1.8] text-text-secondary">
          Brand and demand only matter if the branch model survives. The finance desk remains live as the commercial pressure layer
          for break-even, rent, labor, delivery contribution, and decision-grade templates.
        </p>
        <a href="/restaurant-finance/" class="button-text mt-5">
          Explore UAE Restaurant Finance &rarr;
        </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-shell pb-18 md:pb-24">
      <div class="mb-10 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="mono-label mb-4">Ways to engage</p>
          <h2 class="section-title max-w-[15ch]">
            Entry points for founders, marketers, and brand teams.
          </h2>
        </div>
      </div>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4">
        {growthOffers.map((offer) => (
          <PillarResourceCard
            eyebrow={offer.eyebrow}
            title={offer.title}
            description={offer.description}
            href={offer.href}
            metadata="Start here"
          />
        ))}
      </div>
  </section>

  <PillarCTA
    eyebrow="Final CTA"
    title="If growth feels fragmented, fix the system before you ask the channels to work harder."
    description="Use the growth audit, strategy call, 90-day plan, or fractional CMO path to identify what is actually constraining brand momentum, footfall, delivery, and repeat revenue."
    primary={{ href: `${growthAuditPath}#growth-audit`, label: 'Request a Growth Review' }}
    secondary={{ href: `${growthAuditPath}#fractional-cmo`, label: 'Explore Fractional CMO Advisory' }}
  />
</BaseLayout>
