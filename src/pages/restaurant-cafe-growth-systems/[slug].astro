---
import PillarDetailLayout from '../../layouts/PillarDetailLayout.astro';
import type { GrowthPage } from '../../data/restaurantGrowth';
import {
  getGrowthPage,
  getGrowthPageHref,
  growthAuditPath,
  growthBasePath,
  growthNav,
  growthPages,
} from '../../data/restaurantGrowth';

const isDefined = (value: GrowthPage | undefined): value is GrowthPage => Boolean(value);

export async function getStaticPaths() {
  return growthPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;

const related = page.relatedSlugs
  .map((slug: string) => getGrowthPage(slug))
  .filter(isDefined)
  .map((item) => ({
    href: getGrowthPageHref(item.slug),
    title: item.title,
    description: item.outcome,
  }));

const breadcrumbs = [
  { href: '/', label: 'Home' },
  { href: `${growthBasePath}/`, label: 'Growth systems' },
  { href: getGrowthPageHref(page.slug), label: page.navLabel },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://ashmo.io/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Restaurant & Cafe Growth Systems',
      item: `https://ashmo.io${growthBasePath}/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: page.title,
      item: `https://ashmo.io${getGrowthPageHref(page.slug)}`,
    },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: page.title,
  description: page.metaDescription,
  serviceType: page.title,
  provider: {
    '@type': 'Person',
    name: 'Ashraf Hassan',
    alternateName: 'Ashmo',
    url: 'https://ashmo.io/ashraf-hassan/',
  },
  url: `https://ashmo.io${getGrowthPageHref(page.slug)}`,
};
---

<PillarDetailLayout
  title={page.metaTitle}
  description={page.metaDescription}
  eyebrow={page.eyebrow}
  navItems={growthNav}
  breadcrumbs={breadcrumbs}
  related={related}
  primaryCta={{ href: `${growthAuditPath}#growth-audit`, label: 'Request a growth audit' }}
  secondaryCta={{ href: `${growthAuditPath}#strategy-call`, label: 'Book a strategy call' }}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify([breadcrumbSchema, serviceSchema])} />

  <section>
    <p class="text-[0.72rem] uppercase tracking-[0.18em] text-accent mb-3">The business problem</p>
    <h2 class="font-heading text-3xl md:text-[2.4rem] tracking-[-0.03em] leading-[1.06] mb-5">
      Why this matters commercially.
    </h2>
    <div class="space-y-4">
      {page.problem.map((paragraph: string) => (
        <p class="text-[1rem] text-text-secondary font-light leading-[1.85]">{paragraph}</p>
      ))}
    </div>
  </section>

  <section>
    <p class="text-[0.72rem] uppercase tracking-[0.18em] text-accent mb-3">Strategic approach</p>
    <h2 class="font-heading text-3xl md:text-[2.4rem] tracking-[-0.03em] leading-[1.06] mb-5">
      How the work is structured.
    </h2>
    <p class="text-[1rem] text-text-secondary font-light leading-[1.85] mb-8">{page.approachIntro}</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {page.approach.map((step: { title: string; description: string }, index: number) => (
        <div class="rounded-[1.25rem] border border-border bg-surface/70 px-5 py-5">
          <p class="text-[0.68rem] uppercase tracking-[0.18em] text-accent mb-3">Step 0{index + 1}</p>
          <p class="font-heading text-[1.2rem] leading-[1.08] mb-3">{step.title}</p>
          <p class="text-[0.94rem] text-text-secondary font-light leading-[1.72]">{step.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div>
      <p class="text-[0.72rem] uppercase tracking-[0.18em] text-accent mb-3">What is included</p>
      <h2 class="font-heading text-3xl md:text-[2.2rem] tracking-[-0.03em] leading-[1.06] mb-5">
        The operating layers covered.
      </h2>
      <ul class="space-y-3 list-none p-0 m-0">
        {page.includes.map((item: string) => (
          <li class="rounded-[1rem] border border-border bg-surface/60 px-4 py-4 text-[0.96rem] text-text-secondary font-light leading-[1.7]">
            {item}
          </li>
        ))}
      </ul>
    </div>

    <div>
      <p class="text-[0.72rem] uppercase tracking-[0.18em] text-accent mb-3">Who it is for</p>
      <h2 class="font-heading text-3xl md:text-[2.2rem] tracking-[-0.03em] leading-[1.06] mb-5">
        The teams who benefit most.
      </h2>
      <ul class="space-y-3 list-none p-0 m-0">
        {page.whoItsFor.map((item: string) => (
          <li class="rounded-[1rem] border border-border bg-surface/60 px-4 py-4 text-[0.96rem] text-text-secondary font-light leading-[1.7]">
            {item}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section>
    <p class="text-[0.72rem] uppercase tracking-[0.18em] text-accent mb-3">Common mistakes</p>
    <h2 class="font-heading text-3xl md:text-[2.4rem] tracking-[-0.03em] leading-[1.06] mb-5">
      What weakens the result.
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {page.mistakes.map((item: string) => (
        <div class="rounded-[1.25rem] border border-border bg-surface/70 px-5 py-5">
          <p class="text-[0.92rem] text-text-secondary font-light leading-[1.72]">{item}</p>
        </div>
      ))}
    </div>
  </section>

  <section>
    <p class="text-[0.72rem] uppercase tracking-[0.18em] text-accent mb-3">Practical deliverables</p>
    <h2 class="font-heading text-3xl md:text-[2.4rem] tracking-[-0.03em] leading-[1.06] mb-5">
      What the team can actually use.
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {page.deliverables.map((item: string) => (
        <div class="rounded-[1.25rem] border border-border bg-surface/70 px-5 py-5">
          <p class="text-[0.68rem] uppercase tracking-[0.18em] text-accent mb-3">Deliverable</p>
          <p class="font-heading text-[1.15rem] leading-[1.08]">{item}</p>
        </div>
      ))}
    </div>
  </section>
</PillarDetailLayout>
