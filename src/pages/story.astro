---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PageSection from '../components/PageSection.astro';
import { personId, personSchema, websiteId } from '../data/entity';

const storyStats = [
  { label: 'years across business, brand, and digital', value: '25+' },
  { label: 'outlet-scale brand experience', value: '100+' },
  { label: 'countries of market exposure', value: '13' },
];

const storyChapters = [
  {
    step: '01',
    eyebrow: 'This is not an origin story',
    title: 'Context for how Ashmo.io thinks about business.',
    intro:
      'This page is context for how I think about business: how customers decide, how brands earn memory, how growth creates complexity, and how AI is changing execution without replacing judgment.',
    body: [
      'My foundation came from trade and retail before it came from strategy decks. Product, pricing, stock movement, margins, footfall, and customer trust taught me that business is not abstract. Every decision eventually meets the customer.',
      'That early phase included hands-on retail work, but the useful part was not the location. It was the commercial discipline it built.',
    ],
  },
  {
    step: '02',
    eyebrow: 'The creative and digital shift',
    title: 'Technology and design changed how I understood business.',
    intro:
      'IT training, multimedia, web, graphic design, and advertising taught me that a good product can still lose if the market cannot understand it.',
    body: [
      'This is where commercial instinct started meeting brand systems. Design was not only about looking better. It became a way to shape perception, make choices clearer, and help the market understand what was worth remembering.',
      'That shift still shapes the work here: practical systems, clear language, and tools that make business decisions easier to see.',
    ],
  },
  {
    step: '03',
    eyebrow: 'The brand-building stretch',
    title: 'Years inside FiLLi Cafe shaped the strongest part of my thinking.',
    intro:
      'The work was not only creative. It was about protecting a product hero, building brand memory, supporting multi-location growth, aligning teams, and keeping the brand clear while the market kept changing.',
    body: [
      'Multi-location growth makes weak systems visible. It forces discipline around naming, campaigns, product focus, franchise clarity, market adaptation, and consistency.',
      'That experience now sits underneath the commercial breakdowns, growth systems, and market notes across Ashmo.io.',
    ],
  },
  {
    step: '04',
    eyebrow: 'The current phase',
    title: 'Ashmo.io is a platform, not a diary.',
    intro:
      'Today, ashmo.io is where I turn that experience into practical intelligence: growth systems, market notes, AI-age marketing workflows, brand breakdowns, and decision frameworks for people building in fast-moving categories.',
    body: [
      'The goal is not to make the past bigger. It is to make useful judgment easier to apply now.',
      'That means clearer frameworks, better market sense, sharper positioning, and decision tools that help founders and teams move with less noise.',
    ],
  },
];

const startingPoints = [
  {
    href: '/growth/',
    label: 'Growth Systems',
    detail: 'Practical frameworks and review paths for restaurants, cafes, and founder-driven brands.',
  },
  {
    href: '/intelligence/',
    label: 'Market Intelligence',
    detail: 'Public-source signals, country briefings, category notes, and commercial observations.',
  },
  {
    href: '/thinking/',
    label: 'Insights',
    detail: 'Field notes, playbooks, brand breakdowns, AI workflows, and decision frameworks.',
  },
  {
    href: '/work/',
    label: 'Case Studies',
    detail: 'Proof from brand systems, F&B growth, platform building, and commercial execution.',
  },
  {
    href: '/podcast/',
    label: 'Conversations',
    detail: 'Long-form conversations on brand, growth, founder clarity, and business judgment.',
  },
];

const storyLinks = [
  { href: '/thinking/', label: 'Browse Insights', accent: true },
  { href: '/growth/', label: 'Explore Growth Systems' },
  { href: '/work/', label: 'View Case Studies' },
];

const profilePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': 'https://ashmo.io/story/#profile',
  url: 'https://ashmo.io/story/',
  name: 'Background — Ashraf Hassan',
  description:
    'Ashraf Hassan, also known as Ashmo, connects trade, brand systems, digital growth, market intelligence, and AI-age execution into practical commercial thinking.',
  isPartOf: {
    '@id': websiteId,
  },
  about: {
    '@id': personId,
  },
  mainEntity: personSchema,
};
---

<BaseLayout title="About Ashmo — Brand Systems" description="How Ashraf Hassan connects business experience, F&B growth, brand systems, market intelligence, and AI-age execution into practical thinking.">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(profilePageSchema)} />

  <PageHero
    eyebrow="About Ashmo"
    title="Business judgment shaped by trade, brand systems, digital growth, and"
    highlight="AI-age execution."
    description="People know me as Ashmo. I use ashmo.io to document commercial intelligence for founders, marketers, and F&B business builders who need clearer thinking before they scale louder."
    primary={{ href: '/thinking/', label: 'Browse Insights' }}
    secondary={{ href: '/growth/', label: 'Explore Growth Systems' }}
    stats={storyStats.map((stat) => ({ value: stat.value, label: stat.label }))}
    sideEyebrow="What this page is really about"
    sideTitle="Context for the commercial intelligence platform."
    sideDescription="This is not a personal-brand biography. It is context for the judgment behind the growth systems, market notes, AI workflows, brand breakdowns, and practical frameworks on Ashmo.io."
    sideCards={[
      {
        eyebrow: 'A working belief',
        description: 'Building something real requires thinking clearly under conditions that actively work against clarity.',
      },
    ]}
  />

  <PageSection
    eyebrow="About in chapters"
    title="The useful context behind the"
    highlight="platform."
    description="The useful part is not biography. It is the pattern recognition each phase produced and how that judgment becomes practical intelligence now."
  >
    <div class="mt-10 space-y-5">
      {storyChapters.map((chapter) => (
        <article class="feature-card hover-lift p-6 md:p-8">
          <div class="relative z-10 grid gap-6 lg:grid-cols-[auto_minmax(0,0.38fr)_minmax(0,0.62fr)] lg:gap-8">
            <div>
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-[1rem] border border-white/10 bg-white/[0.04] font-mono text-[0.72rem] font-semibold uppercase tracking-[0.08em] text-accent-light">
                {chapter.step}
              </span>
            </div>
            <div>
              <p class="mono-label">{chapter.eyebrow}</p>
              <h3 class="mt-4 text-[1.55rem] font-bold leading-[1.08] text-text md:text-[1.9rem]">
                {chapter.title}
              </h3>
              <p class="mt-5 text-[0.98rem] leading-[1.82] text-text-secondary">
                {chapter.intro}
              </p>
            </div>
            <div class="space-y-4">
              {chapter.body.map((paragraph) => (
                <p class="text-[0.95rem] leading-[1.82] text-text-secondary">
                  {paragraph}
                </p>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </PageSection>

  <section class="section-shell pb-24 md:pb-32">
    <div class="cta-panel gradient-border p-6 md:p-8 lg:p-10">
      <div class="relative z-10 grid gap-8 lg:grid-cols-[0.7fr_1fr] lg:items-end">
        <div>
          <p class="mono-label mb-4">Start with the useful parts</p>
          <h2 class="section-title max-w-[13ch]">
            Move from context into practical commercial intelligence.
          </h2>
        </div>
        <div>
          <p class="body-lead max-w-[42rem]">
            If you want the shortest route into Ashmo.io, begin with the parts built for decisions.
          </p>
          <div class="mt-8 grid gap-4 md:grid-cols-3">
            {startingPoints.map((item) => (
              <a href={item.href} class="feature-card hover-lift block p-5 no-underline">
                <div class="relative z-10">
                  <p class="text-[1.22rem] font-bold leading-[1.12] text-text">
                    {item.label}
                  </p>
                  <p class="mt-4 text-[0.94rem] leading-[1.72] text-text-secondary">
                    {item.detail}
                  </p>
                </div>
              </a>
            ))}
          </div>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            {storyLinks.map((link) => (
              <a href={link.href} class:list={[link.accent ? 'button-gradient' : 'button-secondary']}>
                {link.label}
                <span aria-hidden="true">&rarr;</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
