---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TipSectionNav from '../../components/tip/TipSectionNav.astro';
import TipDisclaimerBox from '../../components/tip/TipDisclaimerBox.astro';
import { tipBuyerChecklist } from '../../data/tip.mjs';
---

<BaseLayout
  title="Online Product Verification Checklist — TIP"
  description="A practical buyer checklist for checking manufacturer pages, labels, product codes, distributor references, and seller source details."
>
  <TipSectionNav />
  <section class="mx-auto max-w-[1240px] px-6 pb-16 pt-10 md:px-12 md:pb-20 md:pt-14">
    <p class="mono-label">Buyer guide</p>
    <h1 class="mt-5 max-w-[14ch] text-[3rem] font-extrabold leading-[0.98] tracking-[-0.06em] text-text md:text-[5rem]">How to check original products before buying online.</h1>
    <p class="mt-5 max-w-[48rem] text-[1rem] leading-[1.85] text-text-secondary md:text-[1.08rem]">
      Verification is a sequence of small checks. Start with the official source, collect proof points, and ask for clarification when the visible information is incomplete.
    </p>
  </section>
  <section class="mx-auto max-w-[1240px] px-6 pb-18 md:px-12 md:pb-22">
    <div class="grid gap-4 lg:grid-cols-2">
      {tipBuyerChecklist.map((item, index) => (
        <article class="rounded-[1.35rem] border border-white/8 bg-white/[0.045] p-5">
          <p class="font-mono text-[0.62rem] uppercase tracking-[0.08em] text-accent-light">Step {String(index + 1).padStart(2, '0')}</p>
          <h2 class="mt-3 text-[1.35rem] font-semibold tracking-[-0.03em] text-text">{item.title}</h2>
          <p class="mt-3 text-sm leading-[1.8] text-text-secondary">{item.detail}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="mx-auto max-w-[1240px] px-6 pb-24 md:px-12 md:pb-28">
    <TipDisclaimerBox />
  </section>
</BaseLayout>
