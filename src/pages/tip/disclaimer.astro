---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TipSectionNav from '../../components/tip/TipSectionNav.astro';
import TipDisclaimerBox from '../../components/tip/TipDisclaimerBox.astro';
---

<BaseLayout
  title="TIP Disclaimer & Correction Requests"
  description="TIP legal disclaimer, independent educational research policy, trademark notice, and correction-request process."
>
  <TipSectionNav />
  <section class="mx-auto max-w-[1240px] px-6 pb-14 pt-10 md:px-12 md:pb-18 md:pt-14">
    <p class="mono-label">TIP legal position</p>
    <h1 class="mt-5 max-w-[12ch] text-[3rem] font-extrabold leading-[0.98] tracking-[-0.06em] text-text md:text-[5rem]">Disclaimer and correction requests.</h1>
    <p class="mt-5 max-w-[50rem] text-[1rem] leading-[1.85] text-text-secondary md:text-[1.08rem]">
      TIP is designed to help buyers trace public source information carefully. It is not a certification body, enforcement authority, seller-rating platform, or brand representative.
    </p>
  </section>
  <section class="mx-auto max-w-[1240px] px-6 pb-18 md:px-12 md:pb-22">
    <TipDisclaimerBox />
    <div class="mt-6 grid gap-4 lg:grid-cols-2">
      {[
        ['Independent educational platform', 'TIP organizes public information for educational use. Any affiliation or representation must be explicitly stated on the relevant page.'],
        ['Trademark reference only', 'Product names, trademarks, logos, and brand references belong to their respective owners and are used only for identification and educational reference.'],
        ['No authenticity certification', 'A public-source match does not certify an individual item, listing, seller inventory, package, barcode, batch, or invoice.'],
        ['No seller accusations', 'TIP does not accuse sellers or marketplaces. Missing proof is described as missing proof. Unanswered questions remain unanswered questions.'],
        ['Information may change', 'Manufacturer pages, labels, distributor references, and regulatory listings can change. Review the linked official sources before making a decision.'],
        ['Editor-managed publication', 'TIP publishes only products selected and reviewed by the editor. Public pages organize source-backed research; they are not user submissions or automated certifications.'],
      ].map(([title, detail]) => (
        <article class="rounded-[1.3rem] border border-white/8 bg-white/[0.04] p-5">
          <h2 class="text-[1.22rem] font-semibold tracking-[-0.03em] text-text">{title}</h2>
          <p class="mt-3 text-sm leading-[1.8] text-text-secondary">{detail}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="mx-auto max-w-[1240px] px-6 pb-24 md:px-12 md:pb-28">
    <div class="rounded-[1.5rem] border border-accent/20 bg-accent/[0.065] p-6 md:p-7">
      <p class="mono-label">Correction request</p>
      <h2 class="mt-4 text-[1.85rem] font-semibold tracking-[-0.04em] text-text">Send supporting documents for review.</h2>
      <p class="mt-4 max-w-[52rem] text-sm leading-[1.85] text-text-secondary">
        If you are a manufacturer, distributor, reseller, or rights holder and believe any information is inaccurate, please contact us with supporting documents. We will review and correct verified information.
      </p>
      <a href="mailto:hello@ashmo.io?subject=TIP%20correction%20request" class="button-secondary mt-6">Email correction request</a>
    </div>
  </section>
</BaseLayout>
