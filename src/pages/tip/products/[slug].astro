---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FAQSection from '../../../components/FAQSection.astro';
import TipSectionNav from '../../../components/tip/TipSectionNav.astro';
import ConfidenceBadge from '../../../components/tip/ConfidenceBadge.astro';
import TipDisclaimerBox from '../../../components/tip/TipDisclaimerBox.astro';
import TipSourceCard from '../../../components/tip/TipSourceCard.astro';
import TipChecklist from '../../../components/tip/TipChecklist.astro';
import TipRiskSignals from '../../../components/tip/TipRiskSignals.astro';
import { tipOgStatement, tipProducts } from '../../../data/tip.mjs';

export function getStaticPaths() {
  return tipProducts.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const breadcrumbs = [
  { name: 'TIP', href: '/tip/' },
  { name: 'Products', href: '/tip/search/' },
  { name: product.name, href: `/tip/products/${product.slug}/` },
];
const reportSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `${product.name} original source, manufacturer and UAE distributor guide`,
  description: product.summary,
  url: `https://ashmo.io/tip/products/${product.slug}/`,
  dateModified: product.lastReviewedAt,
  about: {
    '@type': 'Thing',
    name: product.name,
    description: `${product.brand} ${product.productType} with ${product.activeIngredient}.`,
  },
};
---

<BaseLayout
  title="Advion Cockroach Gel Source Guide — TIP"
  description="Trace Advion Cockroach Gel Bait to Syngenta source pages, UAE distributor references, label details, and a buyer verification checklist."
  breadcrumbs={breadcrumbs}
  extraSchema={[reportSchema]}
>
  <TipSectionNav />
  <section class="mx-auto max-w-[1240px] px-6 pb-14 pt-10 md:px-12 md:pb-18 md:pt-14">
    <Breadcrumbs items={breadcrumbs.slice(0, -1)} />
    <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,0.67fr)_minmax(280px,0.33fr)]">
      <div>
        <div class="flex flex-wrap items-center gap-3">
          <p class="mono-label">OG Trace Report · {product.countryReference}</p>
          <ConfidenceBadge status={product.status} />
        </div>
        <h1 class="mt-5 max-w-[13ch] text-[3rem] font-extrabold leading-[0.96] tracking-[-0.06em] text-text md:text-[5.1rem]">{product.name}</h1>
        <p class="mt-6 max-w-[46rem] text-[1rem] leading-[1.85] text-text-secondary md:text-[1.08rem]">{product.summary}</p>
      </div>
      <aside class="rounded-[1.6rem] border border-white/8 bg-white/[0.045] p-5 md:p-6">
        <p class="mono-label">Research status</p>
        <dl class="mt-5 grid gap-4">
          <div>
            <dt class="font-mono text-[0.62rem] uppercase tracking-[0.08em] text-text-tertiary">Confidence</dt>
            <dd class="mt-1 text-sm text-text">{product.confidenceLevel}</dd>
          </div>
          <div>
            <dt class="font-mono text-[0.62rem] uppercase tracking-[0.08em] text-text-tertiary">Last reviewed</dt>
            <dd class="mt-1 text-sm text-text">{product.lastReviewedAt}</dd>
          </div>
          <div>
            <dt class="font-mono text-[0.62rem] uppercase tracking-[0.08em] text-text-tertiary">Published sources</dt>
            <dd class="mt-1 text-sm text-text">{product.sources.length} public records</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="mx-auto max-w-[1240px] px-6 pb-16 md:px-12 md:pb-20">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {[
        ['Brand', product.brand],
        ['Product type', product.productType],
        ['Active ingredient', product.activeIngredient],
        ['Known manufacturer', product.manufacturer.name],
        ['Reference country', product.manufacturer.country],
        ['Format', product.specification],
        ['Category', product.categoryLabel],
        ['Main use', product.mainUse],
      ].map(([label, value]) => (
        <div class="rounded-[1.15rem] border border-white/8 bg-white/[0.04] p-4">
          <p class="font-mono text-[0.6rem] uppercase tracking-[0.08em] text-text-tertiary">{label}</p>
          <p class="mt-2 text-sm leading-[1.6] text-text">{value}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-[1240px] px-6 pb-16 md:px-12 md:pb-20">
    <div class="grid gap-5 lg:grid-cols-2">
      <article class="rounded-[1.5rem] border border-white/8 bg-white/[0.045] p-6">
        <p class="mono-label">Original manufacturer</p>
        <h2 class="mt-4 text-[1.85rem] font-semibold tracking-[-0.04em] text-text">{product.manufacturer.name}</h2>
        <p class="mt-3 text-sm leading-[1.8] text-text-secondary">{product.manufacturer.country} · {product.manufacturer.confidence}</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href={product.manufacturer.officialProductUrl} target="_blank" rel="noopener noreferrer" class="button-secondary">Official product page</a>
          <a href={product.manufacturer.contactUrl} target="_blank" rel="noopener noreferrer" class="button-secondary">Official contact</a>
        </div>
      </article>
      <article class="rounded-[1.5rem] border border-white/8 bg-white/[0.045] p-6">
        <p class="mono-label">What is not confirmed</p>
        <h2 class="mt-4 text-[1.85rem] font-semibold tracking-[-0.04em] text-text">The exact item still needs checking.</h2>
        <p class="mt-3 text-sm leading-[1.8] text-text-secondary">{product.notConfirmed}</p>
      </article>
    </div>
  </section>

  <section class="mx-auto max-w-[1240px] px-6 pb-16 md:px-12 md:pb-20">
    <p class="mono-label">Official product references</p>
    <h2 class="mt-4 text-[2.2rem] font-semibold tracking-[-0.05em] text-text md:text-[3rem]">Follow the source trail.</h2>
    <div class="mt-7 grid gap-4 lg:grid-cols-2">
      {product.sources.map((source) => <TipSourceCard source={source} />)}
    </div>
  </section>

  <section class="mx-auto max-w-[1240px] px-6 pb-16 md:px-12 md:pb-20">
    <p class="mono-label">UAE distributor information</p>
    <h2 class="mt-4 text-[2.2rem] font-semibold tracking-[-0.05em] text-text md:text-[3rem]">Manufacturer-listed distributor reference.</h2>
    <div class="mt-7 grid gap-4">
      {product.distributors.map((distributor) => (
        <article class="rounded-[1.5rem] border border-white/8 bg-white/[0.045] p-6">
          <div class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between">
            <div>
              <p class="font-mono text-[0.62rem] uppercase tracking-[0.08em] text-accent-light">{distributor.sourceBasis}</p>
              <h3 class="mt-3 text-[1.55rem] font-semibold tracking-[-0.035em] text-text">{distributor.name}</h3>
              <p class="mt-2 text-sm text-text-tertiary">{distributor.tradingName} · {distributor.region}, {distributor.country}</p>
              <p class="mt-4 max-w-[46rem] text-sm leading-[1.75] text-text-secondary">{distributor.note}</p>
            </div>
            <div class="flex flex-wrap gap-3 md:justify-end">
              <a href={distributor.contactUrl} target="_blank" rel="noopener noreferrer" class="button-secondary">Official reference</a>
              <a href={distributor.website} target="_blank" rel="noopener noreferrer" class="button-secondary">Distributor website</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-[1240px] px-6 pb-16 md:px-12 md:pb-20">
    <TipChecklist items={product.buyerChecklist} />
  </section>

  <section class="mx-auto max-w-[1240px] px-6 pb-16 md:px-12 md:pb-20">
    <TipRiskSignals signals={product.riskSignals} />
  </section>

  <section class="mx-auto max-w-[1240px] px-6 pb-16 md:px-12 md:pb-20">
    <div class="grid gap-5 lg:grid-cols-2">
      <article class="rounded-[1.5rem] border border-white/8 bg-white/[0.045] p-6">
        <p class="mono-label">Safe buying questions</p>
        <h2 class="mt-4 text-[1.85rem] font-semibold tracking-[-0.04em] text-text">Ask for the missing proof.</h2>
        <ul class="mt-5 grid list-none gap-3 p-0">
          {product.safeBuyingQuestions.map((question) => (
            <li class="flex gap-3 text-sm leading-[1.75] text-text-secondary">
              <span class="font-mono text-accent-light">?</span>
              {question}
            </li>
          ))}
        </ul>
      </article>
      <article class="rounded-[1.5rem] border border-accent/20 bg-accent/[0.065] p-6">
        <p class="mono-label">OG statement</p>
        <p class="mt-4 text-sm leading-[1.85] text-text-secondary">{tipOgStatement}</p>
      </article>
    </div>
  </section>

  <section class="mx-auto max-w-[1240px] px-6 pb-18 md:px-12 md:pb-22">
    <TipDisclaimerBox />
  </section>

  <FAQSection title="Advion source-check questions" items={product.faqs} />

  <section class="mx-auto max-w-[1240px] px-6 pb-24 md:px-12 md:pb-28">
    <div class="rounded-[1.6rem] border border-white/8 bg-white/[0.045] p-6 md:p-8">
      <p class="mono-label">Continue checking products</p>
      <h2 class="mt-4 text-[2rem] font-semibold tracking-[-0.04em] text-text md:text-[2.7rem]">Search the published TIP product guides.</h2>
      <a href="/tip/search/" class="button-gradient mt-6">Search published products</a>
    </div>
  </section>
</BaseLayout>
