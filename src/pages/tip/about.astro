---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TipSectionNav from '../../components/tip/TipSectionNav.astro';
import TipDisclaimerBox from '../../components/tip/TipDisclaimerBox.astro';
---

<BaseLayout
  title="About TIP — Trust Intelligence Platform"
  description="Why TIP exists, how its public-source research works, and why it uses neutral product-verification language."
>
  <TipSectionNav />
  <section class="mx-auto max-w-[1240px] px-6 pb-16 pt-10 md:px-12 md:pb-20 md:pt-14">
    <p class="mono-label">About TIP</p>
    <h1 class="mt-5 max-w-[12ch] text-[3rem] font-extrabold leading-[0.98] tracking-[-0.06em] text-text md:text-[5rem]">Trust starts with a traceable source.</h1>
    <p class="mt-5 max-w-[50rem] text-[1rem] leading-[1.85] text-text-secondary md:text-[1.08rem]">
      TIP was created from a simple consumer problem: sometimes the same product looks original online, but the buyer cannot easily trace who made it, who distributes it, or what details to check before purchase.
    </p>
  </section>
  <section class="mx-auto max-w-[1240px] px-6 pb-18 md:px-12 md:pb-22">
    <div class="grid gap-4 lg:grid-cols-3">
      {[
        ['Public-source first', 'TIP organizes manufacturer pages, official labels, distributor references, and other public records into a clear research trail.'],
        ['Neutral by design', 'TIP describes missing proof, mismatches, and unanswered questions without accusing a seller, marketplace, or brand.'],
        ['Educational mission', 'TIP helps buyers ask better questions. It does not replace the manufacturer, distributor, seller invoice, or relevant authority.'],
      ].map(([title, detail]) => (
        <article class="rounded-[1.4rem] border border-white/8 bg-white/[0.045] p-6">
          <p class="mono-label">TIP principle</p>
          <h2 class="mt-4 text-[1.5rem] font-semibold tracking-[-0.04em] text-text">{title}</h2>
          <p class="mt-4 text-sm leading-[1.8] text-text-secondary">{detail}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="mx-auto max-w-[1240px] px-6 pb-24 md:px-12 md:pb-28">
    <TipDisclaimerBox />
  </section>
</BaseLayout>

