---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PageSection from '../../components/PageSection.astro';
import FeatureGrid from '../../components/FeatureGrid.astro';
import PageActionPanel from '../../components/PageActionPanel.astro';
import FinanceSectionNav from '../../components/FinanceSectionNav.astro';
import FinanceResourceCard from '../../components/FinanceResourceCard.astro';
import {
  evidenceLayers,
  financeCalculators,
  financeInsights,
  financeMetrics,
  financeServices,
  financeTemplates,
  roadmapPhases,
  trustMarkers,
} from '../../data/restaurantFinance';
---

<BaseLayout
  title="UAE Restaurant Finance"
  description="Decision tools, benchmarks, calculators, and templates for UAE restaurant teams who need to understand branch profitability before they expand."
>
  <PageHero
    eyebrow="UAE Restaurant Finance"
    title="The restaurant decision desk for"
    highlight="branch profitability."
    description="Built for founder-led cafes, QSRs, and small multi-unit teams in the UAE who need to answer one question before they sign, scale, discount, or expand: can this branch actually make money?"
    primary={{ href: '/restaurant-finance/calculators/', label: 'Open calculators' }}
    secondary={{ href: '/restaurant-finance/templates/', label: 'Get templates' }}
    tertiary={{ href: '/restaurant-cafe-growth-systems/', label: 'Growth systems' }}
    stats={[
      { value: String(financeCalculators.length), label: 'calculators' },
      { value: String(financeTemplates.length), label: 'templates' },
      { value: 'UAE', label: 'market lens' },
    ]}
    sideEyebrow="Decision tools"
    sideTitle="The numbers layer inside the growth system."
    sideDescription="This finance desk sits inside the wider Restaurant & Cafe Growth Systems hub for brands that need commercially grounded strategy beyond the numbers."
    sideCards={financeCalculators.slice(0, 4).map((calculator) => ({
      eyebrow: calculator.metric,
      title: calculator.name,
      description: calculator.summary,
    }))}
  />

  <FinanceSectionNav />

  <PageSection
    eyebrow="Why this exists"
    title="Local teams need local numbers, not"
    highlight="recycled theory."
    description="Most restaurant advice is either too generic, too global, or too far from the daily reality of running a branch in the UAE. Ashmo is designed to sit in the middle: practical enough for a founder to use tonight, structured enough to become a real benchmark layer over time."
  >
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,0.72fr)_minmax(18rem,0.28fr)] gap-10 md:gap-14 items-start">
      <div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {evidenceLayers.map((layer, index) => (
            <div class="feature-card p-5">
              <div class="relative z-10">
                <p class="mono-label mb-3">Layer 0{index + 1}</p>
                <p class="text-[1.35rem] font-bold leading-[1.08] text-text">{layer.title}</p>
                <p class="mt-3 text-[0.94rem] leading-[1.75] text-text-secondary">{layer.summary}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="cta-panel p-6">
        <div class="relative z-10">
          <p class="mono-label mb-4">Trust markers</p>
          <div class="space-y-4">
            {trustMarkers.map((marker) => (
              <div class="flex gap-3">
                <span class="mt-2 block h-2 w-2 rounded-full bg-accent"></span>
                <p class="text-[0.94rem] leading-[1.75] text-text-secondary">{marker}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </PageSection>

  <PageSection
    eyebrow="Start here"
    title="The first finance insights that make the whole"
    highlight="section usable."
    description="Begin with the few pieces that explain the financial lens before moving into calculators, templates, or advisory."
    spacing="tight"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
      {financeInsights.slice(0, 3).map((insight) => (
        <FinanceResourceCard
          eyebrow={insight.readTime}
          title={insight.title}
          description={insight.description}
          href={`/restaurant-finance/insights/${insight.slug}/`}
          metadata="Insight"
        />
      ))}
    </div>
    <div class="mt-8">
      <a href="/restaurant-finance/insights/" class="button-secondary">
        All finance insights <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </PageSection>

  <PageSection
    eyebrow="Metrics framework"
    title="What this platform is built to"
    highlight="measure."
    description="The metrics are organized around decisions, not vanity. Each one should help a team decide whether to open, price, schedule, cut, invest, or pause."
  >
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,0.56fr)_minmax(0,0.44fr)] gap-10 md:gap-16">
      <div class="cta-panel p-6 md:p-8">
        <div class="relative z-10">
          <p class="mono-label mb-4">Decision logic</p>
          <p class="text-[1.55rem] font-bold leading-[1.12] text-text">
            Every metric exists because it changes a decision.
          </p>
          <p class="mt-5 text-[0.98rem] leading-[1.8] text-text-secondary">
            That is the standard for this section: no decorative dashboards, no benchmark theatre, and no ratios that do not help a founder act.
          </p>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {financeMetrics.map((group) => (
          <div class="feature-card p-5">
            <div class="relative z-10">
            <p class="text-[1.2rem] font-bold leading-[1.08] text-text mb-4">{group.title}</p>
            <ul class="space-y-2 list-none pl-0">
              {group.items.map((item) => (
                <li class="text-[0.92rem] text-text-secondary leading-[1.6]">{item}</li>
              ))}
            </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </PageSection>

  <PageSection
    eyebrow="Templates and services"
    title="Premium workbooks first, then"
    highlight="advisory."
  >
    <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,0.52fr)_minmax(0,0.48fr)] gap-10">
      <div>
        <p class="mono-label mb-4">Template library</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {financeTemplates.slice(0, 4).map((template) => (
            <FinanceResourceCard
              eyebrow={template.format}
              title={template.name}
              description={template.summary}
              href="/restaurant-finance/templates/"
              metadata="Download"
            />
          ))}
        </div>
      </div>
      <div>
        <p class="mono-label mb-4">Productized services</p>
        <div class="grid grid-cols-1 gap-4">
          {financeServices.slice(0, 3).map((service) => (
            <FinanceResourceCard
              eyebrow="Advisory"
              title={service.name}
              description={service.summary}
              href="/restaurant-finance/services/"
              metadata={service.outcome}
              accent="soft"
            />
          ))}
        </div>
      </div>
    </div>
  </PageSection>

  <PageSection
    eyebrow="How it unfolds"
    title="Three phases. One"
    highlight="compounding system."
  >
    <FeatureGrid columns="3" items={roadmapPhases.map((phase) => ({ title: phase.title, description: phase.summary }))} />
  </PageSection>

  <PageActionPanel
    eyebrow="Next step"
    title="Start with branch economics before chasing"
    highlight="more growth."
    description="Use the calculators. Download the templates. If the numbers still look foggy, move into a review."
    primary={{ href: '/restaurant-finance/calculators/', label: 'Open tools' }}
    secondary={{ href: '/restaurant-finance/services/', label: 'Review services' }}
  />
</BaseLayout>
