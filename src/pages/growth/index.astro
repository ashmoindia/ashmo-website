---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Growth Systems — F&B Brand Strategy"
  description="Practical growth systems for restaurants, cafes, and founder-driven brands: positioning, local demand, campaigns, CRM, delivery visibility, and measurement."
>
  <section class="section-shell pt-14 pb-24 md:pt-20 md:pb-32">
    <div class="cta-panel gradient-border p-6 md:p-8 lg:p-10">
      <div class="relative z-10 max-w-[720px]">
        <p class="mono-label mb-5">Growth Systems</p>
        <h1 class="hero-title">
          Practical growth systems for restaurants, cafes, and <span class="gradient-text">founder-driven brands.</span>
        </h1>
        <p class="body-lead mt-7">
          The Growth Systems hub now lives at the existing Restaurant & Cafe Growth Systems route while the site keeps legacy links stable.
        </p>
        <div class="mt-9 flex flex-col gap-4 sm:flex-row">
          <a href="/restaurant-cafe-growth-systems/" class="button-gradient">
            Open Growth Systems
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a href="/contact/" class="button-secondary">
            Request a Growth Review
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
